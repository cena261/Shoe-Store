@{
    ViewBag.Title = "Products";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayoutPage.cshtml";
    ViewData["PageTitle"] = "Products Management";

    var products = ViewBag.Products as List<ShoeStore.Areas.Admin.Models.DTOs.ProductListItemDTO>;
    var search = ViewBag.Search as string;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalProducts = (int)ViewBag.TotalProducts;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        <div class="d-flex">
            <div>@TempData["SuccessMessage"]</div>
        </div>
        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
    </div>
}

<div class="row mb-3">
    <div class="col">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <form method="get" class="d-flex gap-2">
                    <input type="text" name="search" class="form-control" placeholder="Search products..." value="@search" style="width: 300px;">
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (!string.IsNullOrEmpty(search))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
                    }
                </form>
            </div>
            <div>
                <a href="@Url.Action("Create")" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                        <path d="M12 5l0 14"></path>
                        <path d="M5 12l14 0"></path>
                    </svg>
                    Create Product
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Variants</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (products != null && products.Any())
                        {
                            foreach (var product in products)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.FirstImageURL))
                                        {
                                            <img src="@product.FirstImageURL" alt="@product.ProductName" class="avatar avatar-md" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="avatar avatar-md" style="background-color: #e9ecef;">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                                    <path d="M15 8h.01"></path>
                                                    <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z"></path>
                                                    <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5"></path>
                                                    <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3"></path>
                                                </svg>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold">@product.ProductName</div>
                                        <div class="text-secondary">@product.Slug</div>
                                    </td>
                                    <td>@product.CategoryName</td>
                                    <td>
                                        @if (product.PromotionPrice.HasValue)
                                        {
                                            <div><strong>@product.PromotionPrice.Value.ToString("N0")₫</strong></div>
                                            <div class="text-secondary"><s>@product.Price.ToString("N0")₫</s></div>
                                        }
                                        else
                                        {
                                            <div>@product.Price.ToString("N0")₫</div>
                                        }
                                    </td>
                                    <td>@product.TotalVariants</td>
                                    <td>
                                        <span class="badge @(product.TotalStock > 0 ? "bg-success" : "bg-danger")">
                                            @product.TotalStock
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                            @(product.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@product.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            <a href="@Url.Action("Edit", new { id = product.ProductID })" class="btn btn-sm btn-primary">Edit</a>
                                            <button class="btn btn-sm btn-danger" onclick="deleteProduct(@product.ProductID, '@product.ProductName')">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="text-secondary">No products found</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (totalPages > 1)
            {
                <div class="card-footer d-flex align-items-center">
                    <p class="m-0 text-secondary">Showing <span>@((page - 1) * 20 + 1)</span> to <span>@Math.Min(page * 20, totalProducts)</span> of <span>@totalProducts</span> products</p>
                    <ul class="pagination m-0 ms-auto">
                        @if (page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { search = search, page = page - 1 })">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                        <path d="M15 6l-6 6l6 6"></path>
                                    </svg>
                                    prev
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { search = search, page = i })">@i</a>
                            </li>
                        }

                        @if (page < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { search = search, page = page + 1 })">
                                    next
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                        <path d="M9 6l6 6l-6 6"></path>
                                    </svg>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
    function deleteProduct(productId, productName) {
        if (!confirm('Are you sure you want to delete "' + productName + '"? This will also delete all variants and images.')) {
            return;
        }

        fetch('@Url.Action("Delete")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ id: productId })
        })
        .then(response => response.json())
        .then(result => {
            if (result.Status) {
                window.location.reload();
            } else {
                alert('Error: ' + result.Message);
            }
        })
        .catch(error => {
            alert('Error deleting product');
        });
    }
    </script>
}
