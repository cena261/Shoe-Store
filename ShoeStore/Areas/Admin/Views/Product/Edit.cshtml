@model ShoeStore.Areas.Admin.Models.DTOs.ProductFormDTO
@{
    ViewBag.Title = "Edit Product";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayoutPage.cshtml";
    ViewData["PageTitle"] = ViewBag.PageTitle;

    var categories = ViewBag.Categories as List<ShoeStore.Models.Categories>;
}

<section style="padding: 1rem 1rem 5rem; margin: 0 auto;">
    <div style="max-width: 72rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem;">

        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <a href="@Url.Action("Index", "Product", new { area = "Admin" })" style="display: flex; align-items: center; gap: 0.5rem; color: #71717a; text-decoration: none; transition: color 0.15s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                <span style="font-weight: 600;">Back to Products</span>
            </a>
            <p style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.35em; color: #a1a1aa; margin: 0;">Product Management</p>
            <h1 style="font-size: 3rem; font-weight: 700; margin: 0; line-height: 1;">Edit Product</h1>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background: #fee2e2; border: 1px solid #fca5a5; border-radius: 24px; padding: 1rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; color: #991b1b; font-weight: 500;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        @using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { style = "display: flex; flex-direction: column; gap: 2rem;" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ProductID)

            <div style="border-radius: 24px; border: 1px solid #e4e4e7; background: white; padding: 2rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);">
                <h2 style="font-size: 1.5rem; font-weight: 700; margin: 0 0 1.5rem 0; color: #18181b;">Basic Information</h2>

                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">
                            Product Name <span style="color: #ef4444;">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.ProductName, new {
                            style = "width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.9375rem; outline: none; transition: all 0.15s;",
                            placeholder = "Enter product name",
                            maxlength = "100"
                        })
                        @Html.ValidationMessageFor(m => m.ProductName, "", new { style = "display: block; margin-top: 0.5rem; font-size: 0.875rem; color: #ef4444;" })
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">
                            Slug <span style="color: #ef4444;">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.Slug, new {
                            style = "width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.9375rem; outline: none; transition: all 0.15s;",
                            placeholder = "product-slug",
                            maxlength = "150"
                        })
                        @Html.ValidationMessageFor(m => m.Slug, "", new { style = "display: block; margin-top: 0.5rem; font-size: 0.875rem; color: #ef4444;" })
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.5rem;">
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">
                            Category <span style="color: #ef4444;">*</span>
                        </label>
                        @Html.DropDownListFor(m => m.CategoryID,
                            new SelectList(categories, "CategoryID", "CategoryName", Model.CategoryID),
                            "Select Category",
                            new { style = "width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.9375rem; outline: none; transition: all 0.15s; background: white;" })
                        @Html.ValidationMessageFor(m => m.CategoryID, "", new { style = "display: block; margin-top: 0.5rem; font-size: 0.875rem; color: #ef4444;" })
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">
                            Price (VNĐ) <span style="color: #ef4444;">*</span>
                        </label>
                        <div style="position: relative;">
                            <input type="number" name="Price" id="Price" step="1000" value="@Model.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" style="width: 100%; padding: 0.75rem 1rem; padding-right: 3rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.9375rem; outline: none; transition: all 0.15s;" placeholder="0" />
                            <span style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: #a1a1aa; font-size: 0.9375rem;">₫</span>
                        </div>
                        @Html.ValidationMessageFor(m => m.Price, "", new { style = "display: block; margin-top: 0.5rem; font-size: 0.875rem; color: #ef4444;" })
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">
                            Promotion Price (VNĐ)
                        </label>
                        <div style="position: relative;">
                            <input type="number" name="PromotionPrice" id="PromotionPrice" step="1000" value="@(Model.PromotionPrice.HasValue ? Model.PromotionPrice.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")" style="width: 100%; padding: 0.75rem 1rem; padding-right: 3rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.9375rem; outline: none; transition: all 0.15s;" placeholder="0" />
                            <span style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: #a1a1aa; font-size: 0.9375rem;">₫</span>
                        </div>
                        @Html.ValidationMessageFor(m => m.PromotionPrice, "", new { style = "display: block; margin-top: 0.5rem; font-size: 0.875rem; color: #ef4444;" })
                    </div>
                </div>

                <div style="margin-top: 1.5rem;">
                    <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">
                        Description
                    </label>
                    @Html.TextAreaFor(m => m.Description, new {
                        rows = 4,
                        style = "width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.9375rem; outline: none; transition: all 0.15s; resize: vertical;",
                        placeholder = "Product description..."
                    })
                </div>

                <div style="border-radius: 12px; background: #fafafa; padding: 1rem; border: 1px solid #e4e4e7; margin-top: 1.5rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                        <div style="flex: 1;">
                            <span style="display: block; font-size: 0.875rem; font-weight: 600; color: #18181b;">Active</span>
                            <small style="display: block; font-size: 0.75rem; color: #71717a; margin-top: 0.25rem;">Product will be visible to customers</small>
                        </div>
                        <label class="toggle-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "toggle-input" })
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div style="border-radius: 24px; border: 1px solid #e4e4e7; background: white; padding: 2rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                    <div>
                        <h2 style="font-size: 1.5rem; font-weight: 700; margin: 0; color: #18181b;">Product Images</h2>
                        <p style="font-size: 0.875rem; color: #71717a; margin: 0.5rem 0 0 0;">Manage product images for different colors</p>
                    </div>
                    <button type="button" onclick="openAddImageModal()" style="padding: 0.625rem 1.25rem; border-radius: 9999px; background: #18181b; color: white; border: none; cursor: pointer; font-size: 0.875rem; font-weight: 600; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.5rem;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14"/>
                        </svg>
                        Add Image
                    </button>
                </div>

                <div id="images-container" style="display: grid; gap: 1rem;">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var image = Model.Images[i];
                            <div class="image-item" style="border-radius: 16px; border: 1px solid #e4e4e7; background: #fafafa; padding: 1.5rem; display: grid; grid-template-columns: 120px 1fr auto; gap: 1.5rem; align-items: start;">
                                @Html.HiddenFor(m => m.Images[i].ImageID)

                                <div>
                                    @if (!string.IsNullOrEmpty(image.ImageURL))
                                    {
                                        <img src="@image.ImageURL" alt="Product" style="width: 120px; height: 120px; object-fit: cover; border-radius: 12px; border: 1px solid #e4e4e7;">
                                    }
                                    else
                                    {
                                        <div style="width: 120px; height: 120px; background: white; border: 1px solid #e4e4e7; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                <polyline points="21 15 16 10 5 21"></polyline>
                                            </svg>
                                        </div>
                                    }
                                </div>

                                <div style="display: grid; gap: 1rem;">
                                    <div>
                                        <label style="display: block; margin-bottom: 0.375rem; font-size: 0.75rem; font-weight: 600; color: #52525b;">Image URL</label>
                                        @Html.TextBoxFor(m => m.Images[i].ImageURL, new {
                                            style = "width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; background: white;",
                                            placeholder = "https://..."
                                        })
                                    </div>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                        <div>
                                            <label style="display: block; margin-bottom: 0.375rem; font-size: 0.75rem; font-weight: 600; color: #52525b;">Style Color</label>
                                            @Html.TextBoxFor(m => m.Images[i].StyleColor, new {
                                                style = "width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; background: white;",
                                                placeholder = "Optional"
                                            })
                                        </div>
                                        <div>
                                            <label style="display: block; margin-bottom: 0.375rem; font-size: 0.75rem; font-weight: 600; color: #52525b;">Display Order</label>
                                            @Html.TextBoxFor(m => m.Images[i].DisplayOrder, new {
                                                type = "number",
                                                style = "width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; background: white;",
                                                placeholder = "Optional"
                                            })
                                        </div>
                                    </div>
                                </div>

                                <button type="button" onclick="removeImage(this)" style="padding: 0.5rem; background: #fee2e2; color: #dc2626; border: none; border-radius: 8px; cursor: pointer; transition: all 0.15s;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 7l16 0"></path>
                                        <path d="M10 11l0 6"></path>
                                        <path d="M14 11l0 6"></path>
                                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
                                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="empty-images" style="text-align: center; padding: 3rem 1rem; color: #71717a;">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin: 0 auto 1rem;">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            <p style="margin: 0; font-weight: 500;">No images added yet</p>
                        </div>
                    }
                </div>
            </div>

            <div style="border-radius: 24px; border: 1px solid #e4e4e7; background: white; padding: 2rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);">
                <h2 style="font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem 0; color: #18181b;">Product Variants</h2>
                <p style="font-size: 0.875rem; color: #71717a; margin: 0 0 1.5rem 0;">Manage product variants by color and size</p>

                @for (int colorIndex = 0; colorIndex < Model.ColorGroups.Count; colorIndex++)
                {
                    var colorGroup = Model.ColorGroups[colorIndex];

                    <div style="border-radius: 16px; border: 1px solid #e4e4e7; background: #fafafa; padding: 1.5rem; margin-bottom: 1.5rem;">
                        <div style="display: grid; grid-template-columns: 120px 1fr; gap: 1.5rem;">
                            <div>
                                @if (!string.IsNullOrEmpty(colorGroup.ImageURL))
                                {
                                    <img src="@colorGroup.ImageURL" alt="@colorGroup.ColorName" style="width: 100%; height: 120px; object-fit: cover; border-radius: 12px; border: 1px solid #e4e4e7;">
                                }
                                else
                                {
                                    <div style="width: 100%; height: 120px; background: white; border: 1px solid #e4e4e7; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#a1a1aa" stroke-width="2">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                            <polyline points="21 15 16 10 5 21"></polyline>
                                        </svg>
                                    </div>
                                }
                            </div>

                            <div>
                                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                                    <div style="width: 24px; height: 24px; border-radius: 50%; border: 2px solid #e4e4e7; background: @(colorGroup.StyleColor ?? "#cccccc");"></div>
                                    <h3 style="font-size: 1.125rem; font-weight: 700; margin: 0; color: #18181b;">@colorGroup.ColorName</h3>
                                    @if (!string.IsNullOrEmpty(colorGroup.StyleColor))
                                    {
                                        <span style="padding: 0.25rem 0.625rem; background: white; border: 1px solid #e4e4e7; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; color: #71717a;">@colorGroup.StyleColor</span>
                                    }
                                </div>

                                <div style="overflow-x: auto; border-radius: 12px; border: 1px solid #e4e4e7; background: white;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <thead style="background: #f9fafb; border-bottom: 1px solid #e4e4e7;">
                                            <tr>
                                                <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.8125rem; font-weight: 600; color: #52525b; width: 15%;">Size</th>
                                                <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.8125rem; font-weight: 600; color: #52525b; width: 20%;">SKU</th>
                                                <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.8125rem; font-weight: 600; color: #52525b; width: 15%;">Stock</th>
                                                <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.8125rem; font-weight: 600; color: #52525b; width: 25%;">Price Override</th>
                                                <th style="padding: 0.75rem 1rem; text-align: center; font-size: 0.8125rem; font-weight: 600; color: #52525b; width: 10%;">Active</th>
                                                <th style="padding: 0.75rem 1rem; text-align: center; font-size: 0.8125rem; font-weight: 600; color: #52525b; width: 10%;"></th>
                                            </tr>
                                        </thead>
                                        <tbody data-color-index="@colorIndex">
                                            @for (int variantIndex = 0; variantIndex < colorGroup.Variants.Count; variantIndex++)
                                            {
                                                var variant = colorGroup.Variants[variantIndex];
                                                var globalIndex = Model.ColorGroups.Take(colorIndex).Sum(cg => cg.Variants.Count) + variantIndex;

                                                <tr style="border-bottom: 1px solid #f4f4f5;">
                                                    <td style="padding: 0.75rem 1rem;">
                                                        @Html.Hidden($"Variants[{globalIndex}].VariantID", variant.VariantID)
                                                        @Html.Hidden($"Variants[{globalIndex}].SizeValue", variant.SizeValue)
                                                        @Html.Hidden($"Variants[{globalIndex}].ColorName", variant.ColorName)
                                                        @Html.Hidden($"Variants[{globalIndex}].StyleColor", variant.StyleColor)
                                                        @Html.Hidden($"Variants[{globalIndex}].SKU", variant.SKU)
                                                        <span style="font-weight: 700; color: #18181b;">@variant.SizeValue</span>
                                                    </td>
                                                    <td style="padding: 0.75rem 1rem;">
                                                        <span style="font-size: 0.875rem; color: #71717a; font-family: monospace;">@variant.SKU</span>
                                                    </td>
                                                    <td style="padding: 0.75rem 1rem;">
                                                        <input type="number" name="Variants[@globalIndex].StockQty" value="@variant.StockQty" min="0" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; outline: none;" />
                                                    </td>
                                                    <td style="padding: 0.75rem 1rem;">
                                                        <div style="position: relative;">
                                                            <input type="number" name="Variants[@globalIndex].PriceOverride" value="@variant.PriceOverride" step="1000" placeholder="Optional" style="width: 100%; padding: 0.5rem 0.75rem; padding-right: 2.5rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; outline: none;" />
                                                            <span style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: #a1a1aa; font-size: 0.75rem;">₫</span>
                                                        </div>
                                                    </td>
                                                    <td style="padding: 0.75rem 1rem; text-align: center;">
                                                        <input type="checkbox" name="Variants[@globalIndex].IsActive" value="true" @(variant.IsActive ? "checked" : "") style="width: 1.125rem; height: 1.125rem; border: 2px solid #e4e4e7; border-radius: 4px; cursor: pointer;" />
                                                    </td>
                                                    <td style="padding: 0.75rem 1rem; text-align: center;">
                                                        <button type="button" onclick="removeVariant(this)" style="padding: 0.5rem; background: #fee2e2; color: #dc2626; border: none; border-radius: 8px; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; justify-content: center;">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M4 7l16 0"></path>
                                                                <path d="M10 11l0 6"></path>
                                                                <path d="M14 11l0 6"></path>
                                                                <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
                                                                <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
                                                            </svg>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <button type="button" onclick="openAddSizeModal('@colorGroup.StyleColor', '@colorGroup.ColorName', @colorIndex)" style="margin-top: 1rem; padding: 0.5rem 1rem; background: white; color: #18181b; border: 1px solid #e4e4e7; border-radius: 9999px; font-weight: 600; font-size: 0.875rem; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; gap: 0.5rem;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 5l0 14"></path>
                                        <path d="M5 12l14 0"></path>
                                    </svg>
                                    Add Size
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                <a href="@Url.Action("Index")" style="padding: 0.75rem 1.5rem; background: white; color: #18181b; border: 1px solid #e4e4e7; border-radius: 9999px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.15s; display: inline-flex; align-items: center;">
                    Cancel
                </a>
                <button type="submit" id="submit-btn" style="padding: 0.75rem 1.5rem; background: #18181b; color: white; border: none; border-radius: 9999px; font-weight: 600; font-size: 0.9375rem; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; gap: 0.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    <span>Update Product</span>
                </button>
            </div>
        }
    </div>
</section>

<div id="add-size-modal" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 2000; display: none; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 24px; max-width: 500px; width: 90%; padding: 2rem;">
        <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Add Size Variant</h3>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">Size <span style="color: #ef4444;">*</span></label>
                <input type="text" id="modal-size" placeholder="e.g., 40, 41, 42" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.875rem;">
            </div>
            <div>
                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">SKU <span style="color: #ef4444;">*</span></label>
                <input type="text" id="modal-sku" placeholder="e.g., SHOE-BLK-42" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.875rem;">
            </div>
        </div>
        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" onclick="closeAddSizeModal()" style="flex: 1; padding: 0.75rem 1.5rem; border-radius: 9999px; border: 1px solid #e4e4e7; background: white; font-weight: 600; cursor: pointer;">
                Cancel
            </button>
            <button type="button" onclick="confirmAddSize()" style="flex: 1; padding: 0.75rem 1.5rem; border-radius: 9999px; background: #18181b; color: white; font-weight: 600; cursor: pointer; border: none;">
                Add Size
            </button>
        </div>
    </div>
</div>

<div id="add-image-modal" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 2000; display: none; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 24px; max-width: 600px; width: 90%; padding: 2rem;">
        <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Add Product Image</h3>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">Image URL <span style="color: #ef4444;">*</span></label>
                <input type="text" id="modal-image-url" placeholder="https://..." style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.875rem;">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                    <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">Style Color</label>
                    <input type="text" id="modal-style-color" placeholder="Optional" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.875rem;">
                </div>
                <div>
                    <label style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #52525b;">Display Order</label>
                    <input type="number" id="modal-display-order" placeholder="Optional" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 0.875rem;">
                </div>
            </div>
        </div>
        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" onclick="closeAddImageModal()" style="flex: 1; padding: 0.75rem 1.5rem; border-radius: 9999px; border: 1px solid #e4e4e7; background: white; font-weight: 600; cursor: pointer;">
                Cancel
            </button>
            <button type="button" onclick="confirmAddImage()" style="flex: 1; padding: 0.75rem 1.5rem; border-radius: 9999px; background: #18181b; color: white; font-weight: 600; cursor: pointer; border: none;">
                Add Image
            </button>
        </div>
    </div>
</div>

<style>
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 48px;
        height: 26px;
        cursor: pointer;
        flex-shrink: 0;
        z-index: 1;
    }

    .toggle-input {
        position: absolute;
        opacity: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        cursor: pointer;
        z-index: 2;
    }

    .toggle-slider {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #e4e4e7;
        border-radius: 9999px;
        transition: all 0.3s ease;
        pointer-events: none;
        z-index: 1;
    }

    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 20px;
        width: 20px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        border-radius: 50%;
        transition: all 0.3s ease;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    }

    .toggle-input:checked ~ .toggle-slider {
        background-color: #18181b;
    }

    .toggle-input:checked ~ .toggle-slider:before {
        transform: translateX(22px);
    }

    .toggle-switch:hover .toggle-slider {
        background-color: #d4d4d8;
    }

    .toggle-input:checked ~ .toggle-slider:hover {
        background-color: #27272a;
    }

    input[type="hidden"][name="IsActive"] {
        display: none;
    }
</style>

@section Scripts {
    <script>
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        toast.success('@TempData["SuccessMessage"]', 2000);
        </text>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            var message = error.ErrorMessage.Replace("'", "\\'").Replace("\r", "").Replace("\n", "");
            <text>
            toast.error('@message', 5000);
            </text>
        }
    }

    let variantCounter = @Model.ColorGroups.Sum(cg => cg.Variants.Count);
    let imageCounter = @(Model.Images != null ? Model.Images.Count : 0);
    let currentColorIndex = null;
    let currentStyleColor = '';
    let currentColorName = '';

    const form = document.querySelector('form');
    const submitBtn = document.getElementById('submit-btn');

    form.addEventListener('submit', function(e) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.6';
        submitBtn.querySelector('span').textContent = 'Updating...';
    });

    function openAddSizeModal(styleColor, colorName, colorIndex) {
        currentStyleColor = styleColor;
        currentColorName = colorName;
        currentColorIndex = colorIndex;
        document.getElementById('modal-size').value = '';
        document.getElementById('modal-sku').value = '';
        document.getElementById('add-size-modal').style.display = 'flex';
    }

    function closeAddSizeModal() {
        document.getElementById('add-size-modal').style.display = 'none';
    }

    function confirmAddSize() {
        const size = document.getElementById('modal-size').value.trim();
        const sku = document.getElementById('modal-sku').value.trim();

        if (!size) {
            toast.error('Size is required');
            return;
        }

        if (!sku) {
            toast.error('SKU is required');
            return;
        }

        addVariantRow(size, sku, currentStyleColor, currentColorName, currentColorIndex);
        toast.success('Variant added successfully');
        closeAddSizeModal();
    }

    function addVariantRow(size, sku, styleColor, colorName, colorIndex) {
        const tbody = document.querySelectorAll('tbody[data-color-index]')[colorIndex];
        const newRow = document.createElement('tr');
        newRow.style.borderBottom = '1px solid #f4f4f5';

        newRow.innerHTML = `
            <td style="padding: 0.75rem 1rem;">
                <input type="hidden" name="Variants[${variantCounter}].ColorName" value="${colorName}" />
                <input type="hidden" name="Variants[${variantCounter}].StyleColor" value="${styleColor}" />
                <input type="hidden" name="Variants[${variantCounter}].SKU" value="${sku}" />
                <input type="hidden" name="Variants[${variantCounter}].SizeValue" value="${size}" />
                <span style="font-weight: 700; color: #18181b;">${size}</span>
            </td>
            <td style="padding: 0.75rem 1rem;">
                <span style="font-size: 0.875rem; color: #71717a; font-family: monospace;">${sku}</span>
            </td>
            <td style="padding: 0.75rem 1rem;">
                <input type="number" name="Variants[${variantCounter}].StockQty" value="0" min="0" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; outline: none;" />
            </td>
            <td style="padding: 0.75rem 1rem;">
                <div style="position: relative;">
                    <input type="number" name="Variants[${variantCounter}].PriceOverride" step="1000" placeholder="Optional" style="width: 100%; padding: 0.5rem 0.75rem; padding-right: 2.5rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; outline: none;" />
                    <span style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: #a1a1aa; font-size: 0.75rem;">₫</span>
                </div>
            </td>
            <td style="padding: 0.75rem 1rem; text-align: center;">
                <input type="checkbox" name="Variants[${variantCounter}].IsActive" value="true" checked style="width: 1.125rem; height: 1.125rem; border: 2px solid #e4e4e7; border-radius: 4px; cursor: pointer;" />
            </td>
            <td style="padding: 0.75rem 1rem; text-align: center;">
                <button type="button" onclick="removeVariant(this)" style="padding: 0.5rem; background: #fee2e2; color: #dc2626; border: none; border-radius: 8px; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; justify-content: center;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 7l16 0"></path>
                        <path d="M10 11l0 6"></path>
                        <path d="M14 11l0 6"></path>
                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
                    </svg>
                </button>
            </td>
        `;

        tbody.appendChild(newRow);
        variantCounter++;
    }

    function removeVariant(button) {
        showConfirm(
            'Remove this variant?',
            'Remove Variant',
            function() {
                button.closest('tr').remove();
                toast.success('Variant removed');
            }
        );
    }

    function openAddImageModal() {
        document.getElementById('modal-image-url').value = '';
        document.getElementById('modal-style-color').value = '';
        document.getElementById('modal-display-order').value = '';
        document.getElementById('add-image-modal').style.display = 'flex';
    }

    function closeAddImageModal() {
        document.getElementById('add-image-modal').style.display = 'none';
    }

    function confirmAddImage() {
        const imageUrl = document.getElementById('modal-image-url').value.trim();
        const styleColor = document.getElementById('modal-style-color').value.trim();
        const displayOrder = document.getElementById('modal-display-order').value.trim();

        if (!imageUrl) {
            toast.error('Image URL is required');
            return;
        }

        addImageItem(imageUrl, styleColor, displayOrder);
        toast.success('Image added successfully');
        closeAddImageModal();
    }

    function addImageItem(imageUrl, styleColor, displayOrder) {
        const container = document.getElementById('images-container');
        const emptyState = document.getElementById('empty-images');

        if (emptyState) {
            emptyState.style.display = 'none';
        }

        const imageHtml = `
            <div class="image-item" style="border-radius: 16px; border: 1px solid #e4e4e7; background: #fafafa; padding: 1.5rem; display: grid; grid-template-columns: 120px 1fr auto; gap: 1.5rem; align-items: start;">
                <div>
                    <img src="${imageUrl}" alt="Product" style="width: 120px; height: 120px; object-fit: cover; border-radius: 12px; border: 1px solid #e4e4e7;">
                </div>

                <div style="display: grid; gap: 1rem;">
                    <div>
                        <label style="display: block; margin-bottom: 0.375rem; font-size: 0.75rem; font-weight: 600; color: #52525b;">Image URL</label>
                        <input type="text" name="Images[${imageCounter}].ImageURL" value="${imageUrl}" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; background: white;" placeholder="https://...">
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.375rem; font-size: 0.75rem; font-weight: 600; color: #52525b;">Style Color</label>
                            <input type="text" name="Images[${imageCounter}].StyleColor" value="${styleColor}" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; background: white;" placeholder="Optional">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.375rem; font-size: 0.75rem; font-weight: 600; color: #52525b;">Display Order</label>
                            <input type="number" name="Images[${imageCounter}].DisplayOrder" value="${displayOrder}" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 0.875rem; background: white;" placeholder="Optional">
                        </div>
                    </div>
                </div>

                <button type="button" onclick="removeImage(this)" style="padding: 0.5rem; background: #fee2e2; color: #dc2626; border: none; border-radius: 8px; cursor: pointer; transition: all 0.15s;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 7l16 0"></path>
                        <path d="M10 11l0 6"></path>
                        <path d="M14 11l0 6"></path>
                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
                    </svg>
                </button>
            </div>
        `;

        container.insertAdjacentHTML('beforeend', imageHtml);
        imageCounter++;
    }

    function removeImage(button) {
        showConfirm(
            'Remove this image?',
            'Remove Image',
            function() {
                button.closest('.image-item').remove();

                const container = document.getElementById('images-container');
                const emptyState = document.getElementById('empty-images');
                if (container.querySelectorAll('.image-item').length === 0 && emptyState) {
                    emptyState.style.display = 'block';
                }

                toast.success('Image removed');
            }
        );
    }

    document.getElementById('add-size-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeAddSizeModal();
        }
    });

    document.getElementById('add-image-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeAddImageModal();
        }
    });
    </script>
}
