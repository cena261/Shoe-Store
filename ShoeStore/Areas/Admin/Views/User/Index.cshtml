@{
    ViewBag.Title = "Users";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayoutPage.cshtml";
    ViewData["PageTitle"] = "Users Management";

    var users = ViewBag.Users as List<ShoeStore.Areas.Admin.Models.DTOs.UserListItemDTO>;
    var search = ViewBag.Search as string;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalUsers = (int)ViewBag.TotalUsers;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        <div class="d-flex">
            <div>@TempData["SuccessMessage"]</div>
        </div>
        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
    </div>
}

<div class="row mb-3">
    <div class="col">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search by email, name, or phone..." value="@search" style="width: 400px;">
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Roles</th>
                            <th>Status</th>
                            <th>Joined</th>
                            <th>Last Login</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (users != null && users.Any())
                        {
                            foreach (var user in users)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="avatar avatar-sm me-2" style="background-image: url(https://ui-avatars.com/api/?name=@Uri.EscapeDataString(user.FullName)&background=066fd1&color=fff)"></span>
                                            <div>
                                                <div class="fw-bold">@user.FullName</div>
                                                <div class="text-secondary small">ID: @user.UserId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@(user.Phone ?? "-")</td>
                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            foreach (var role in user.Roles)
                                            {
                                                <span class="badge @(role == "Admin" ? "bg-red" : "bg-blue") me-1 text-white">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(user.IsActive ? "bg-success" : "bg-danger") text-white">
                                            @(user.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (user.LastLogin.HasValue)
                                        {
                                            @user.LastLogin.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-secondary">Never</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            <a href="@Url.Action("Details", new { id = user.UserId })" class="btn btn-cyan" title="View Details" style="width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                                                    <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path>
                                                </svg>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = user.UserId })" class="btn btn-azure" title="Edit User" style="width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path>
                                                    <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"></path>
                                                    <path d="M16 5l3 3"></path>
                                                </svg>
                                            </a>
                                            <a href="@Url.Action("ManageRoles", new { id = user.UserId })" class="btn btn-orange" title="Manage Roles" style="width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"></path>
                                                    <path d="M12 12l8 -4.5"></path>
                                                    <path d="M12 12l0 9"></path>
                                                    <path d="M12 12l-8 -4.5"></path>
                                                    <path d="M16 5.25l-8 4.5"></path>
                                                </svg>
                                            </a>
                                            <button class="btn btn-red" onclick="deleteUser(@user.UserId, '@user.FullName')" title="Deactivate User" style="width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M4 7l16 0"></path>
                                                    <path d="M10 11l0 6"></path>
                                                    <path d="M14 11l0 6"></path>
                                                    <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
                                                    <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-secondary">No users found</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (totalPages > 1)
            {
                <div class="card-footer d-flex align-items-center">
                    <p class="m-0 text-secondary">Showing <span>@((page - 1) * 20 + 1)</span> to <span>@Math.Min(page * 20, totalUsers)</span> of <span>@totalUsers</span> users</p>
                    <ul class="pagination m-0 ms-auto">
                        @if (page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { search = search, page = page - 1 })">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                        <path d="M15 6l-6 6l6 6"></path>
                                    </svg>
                                    prev
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { search = search, page = i })">@i</a>
                            </li>
                        }

                        @if (page < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { search = search, page = page + 1 })">
                                    next
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                        <path d="M9 6l6 6l-6 6"></path>
                                    </svg>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
    function deleteUser(userId, userName) {
        showConfirm(
            'Deactivate user "' + userName + '"?',
            'Deactivate User',
            function() {
                fetch('@Url.Action("Delete")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id: userId })
                })
                .then(response => response.json())
                .then(result => {
                    if (result.Status) {
                        toast.success('User deactivated successfully');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toast.error(result.Message);
                    }
                })
                .catch(error => {
                    toast.error('Error deactivating user');
                });
            }
        );
    }
    </script>
}
