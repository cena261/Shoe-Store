@{
    ViewBag.Title = "Users";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayoutPage.cshtml";
    ViewData["PageTitle"] = "Users Management";

    var users = ViewBag.Users as List<ShoeStore.Areas.Admin.Models.DTOs.UserListItemDTO>;
    var search = ViewBag.Search as string;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalUsers = (int)ViewBag.TotalUsers;
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="position: fixed; top: 2rem; right: 2rem; z-index: 9999; background: #dcfce7; border: 1px solid #86efac; border-radius: 24px; padding: 1rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; color: #166534; font-weight: 500; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<section style="padding: 1rem 1rem 5rem; margin: 0 auto;">
    <div style="max-width: 80rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem;">

        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <a href="@Url.Action("Index", "Admin", new { area = "Admin" })" style="display: flex; align-items: center; gap: 0.5rem; color: #71717a; text-decoration: none; transition: color 0.15s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                <span style="font-weight: 600;">Back to Admin Dashboard</span>
            </a>
            <p style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.35em; color: #a1a1aa;">User Management</p>
            <h1 style="font-size: 3rem; font-weight: 700; line-height: 1;">Users</h1>
        </div>

        <form method="get" style="display: flex; gap: 0.75rem; max-width: 600px;">
            <div style="position: relative; flex: 1;">
                <input type="text" name="search" placeholder="Search by email, name, or phone..." value="@search" style="width: 100%; padding: 0.75rem 1rem; padding-right: 2.5rem; border: 1px solid #e4e4e7; border-radius: 9999px; font-size: 0.875rem; outline: none; transition: all 0.15s;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: #a1a1aa; pointer-events: none;">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="M21 21l-4.35-4.35"></path>
                </svg>
            </div>
            <button type="submit" style="padding: 0.75rem 1.5rem; background: #18181b; color: white; border: none; border-radius: 9999px; font-weight: 600; font-size: 0.875rem; cursor: pointer; transition: all 0.15s; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="M21 21l-4.35-4.35"></path>
                </svg>
                Search
            </button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a href="@Url.Action("Index")" style="padding: 0.75rem 1.5rem; background: white; color: #18181b; border: 1px solid #e4e4e7; border-radius: 9999px; font-weight: 600; font-size: 0.875rem; text-decoration: none; transition: all 0.15s; display: flex; align-items: center;">Clear</a>
            }
        </form>

        <div style="overflow-x: auto; border-radius: 24px; border: 1px solid #e4e4e7; background: white; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);">
            <table style="width: 100%; border-collapse: collapse;">
                <thead style="border-bottom: 1px solid #e4e4e7; background: #fafafa;">
                    <tr>
                        <th style="padding: 1rem 1.5rem; text-align: left; font-size: 0.875rem; font-weight: 600; color: #52525b;">User</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; font-size: 0.875rem; font-weight: 600; color: #52525b;">Email</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; font-size: 0.875rem; font-weight: 600; color: #52525b;">Phone</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; font-size: 0.875rem; font-weight: 600; color: #52525b;">Roles</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; font-size: 0.875rem; font-weight: 600; color: #52525b;">Status</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; font-size: 0.875rem; font-weight: 600; color: #52525b;">Joined</th>
                        <th style="padding: 1rem 1.5rem; text-align: left; font-size: 0.875rem; font-weight: 600; color: #52525b;">Last Login</th>
                        <th style="padding: 1rem 1.5rem; text-align: center; font-size: 0.875rem; font-weight: 600; color: #52525b;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (users != null && users.Any())
                    {
                        foreach (var user in users)
                        {
                            <tr style="border-bottom: 1px solid #f4f4f5; transition: background-color 0.15s;">
                                <td style="padding: 1rem 1.5rem;">
                                    <div style="display: flex; align-items: center; gap: 0.875rem;">
                                        <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 0.875rem; flex-shrink: 0;">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div style="display: flex; flex-direction: column;">
                                            <div style="font-weight: 600; color: #18181b;">@user.FullName</div>
                                            <div style="font-size: 0.8125rem; color: #71717a;">ID: @user.UserId</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    <span style="color: #52525b;">@user.Email</span>
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    <span style="color: #52525b;">@(user.Phone ?? "-")</span>
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        foreach (var role in user.Roles)
                                        {
                                            <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; margin-right: 0.375rem; @(role == "Admin" ? "background: #fee2e2; color: #991b1b;" : "background: #dbeafe; color: #1e40af;")">
                                                @role
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: #a1a1aa;">-</span>
                                    }
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; @(user.IsActive ? "background: #dcfce7; color: #166534;" : "background: #fee2e2; color: #991b1b;")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    <span style="color: #71717a; font-size: 0.875rem;">@user.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    @if (user.LastLogin.HasValue)
                                    {
                                        <span style="color: #71717a; font-size: 0.875rem;">@user.LastLogin.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span style="color: #a1a1aa; font-size: 0.875rem;">Never</span>
                                    }
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                        <a href="@Url.Action("Details", new { id = user.UserId })" style="padding: 0.5rem; background: #3b82f6; color: white; border: none; border-radius: 9999px; cursor: pointer; transition: all 0.15s; display: flex; align-items: center; text-decoration: none;" title="View Details">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                                                <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path>
                                            </svg>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = user.UserId })" style="padding: 0.5rem; background: #06b6d4; color: white; border: none; border-radius: 9999px; cursor: pointer; transition: all 0.15s; display: flex; align-items: center; text-decoration: none;" title="Edit User">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path>
                                                <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"></path>
                                                <path d="M16 5l3 3"></path>
                                            </svg>
                                        </a>
                                        <a href="@Url.Action("ManageRoles", new { id = user.UserId })" style="padding: 0.5rem; background: #f97316; color: white; border: none; border-radius: 9999px; cursor: pointer; transition: all 0.15s; display: flex; align-items: center; text-decoration: none;" title="Manage Roles">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"></path>
                                                <path d="M12 12l8 -4.5"></path>
                                                <path d="M12 12l0 9"></path>
                                                <path d="M12 12l-8 -4.5"></path>
                                            </svg>
                                        </a>
                                        <button style="padding: 0.5rem; background: #ef4444; color: white; border: none; border-radius: 9999px; cursor: pointer; transition: all 0.15s; display: flex; align-items: center;" onclick="deleteUser(@user.UserId, '@user.FullName')" title="Deactivate User">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M4 7l16 0"></path>
                                                <path d="M10 11l0 6"></path>
                                                <path d="M14 11l0 6"></path>
                                                <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path>
                                                <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 5rem 2rem; color: #a1a1aa;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin: 0 auto 1rem; display: block;">
                                    <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
                                    <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    <path d="M21 21v-2a4 4 0 0 0 -3 -3.85"></path>
                                </svg>
                                <div style="font-weight: 500;">No users found</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-top: 1px solid #e4e4e7;">
                    <p style="margin: 0; color: #71717a; font-size: 0.875rem;">
                        Showing <strong>@((page - 1) * 20 + 1)</strong> to <strong>@Math.Min(page * 20, totalUsers)</strong> of <strong>@totalUsers</strong> users
                    </p>
                    <div style="display: flex; gap: 0.5rem;">
                        @if (page > 1)
                        {
                            <a href="@Url.Action("Index", new { search = search, page = page - 1 })" style="padding: 0.5rem 0.875rem; background: white; color: #18181b; border: 1px solid #e4e4e7; border-radius: 9999px; font-weight: 600; font-size: 0.875rem; text-decoration: none; transition: all 0.15s; display: flex; align-items: center;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.25rem;">
                                    <path d="M15 6l-6 6l6 6"></path>
                                </svg>
                                Prev
                            </a>
                        }

                        @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                        {
                            if (i == page)
                            {
                                <span style="padding: 0.5rem 0.875rem; background: #18181b; color: white; border-radius: 9999px; font-weight: 600; font-size: 0.875rem; display: inline-block;">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { search = search, page = i })" style="padding: 0.5rem 0.875rem; background: white; color: #18181b; border: 1px solid #e4e4e7; border-radius: 9999px; font-weight: 600; font-size: 0.875rem; text-decoration: none; transition: all 0.15s;">@i</a>
                            }
                        }

                        @if (page < totalPages)
                        {
                            <a href="@Url.Action("Index", new { search = search, page = page + 1 })" style="padding: 0.5rem 0.875rem; background: white; color: #18181b; border: 1px solid #e4e4e7; border-radius: 9999px; font-weight: 600; font-size: 0.875rem; text-decoration: none; transition: all 0.15s; display: flex; align-items: center;">
                                Next
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 0.25rem;">
                                    <path d="M9 6l6 6l-6 6"></path>
                                </svg>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
    function deleteUser(userId, userName) {
        showConfirm(
            'Deactivate user "' + userName + '"?',
            'Deactivate User',
            function() {
                fetch('@Url.Action("Delete")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id: userId })
                })
                .then(response => response.json())
                .then(result => {
                    if (result.Status) {
                        toast.success('User deactivated successfully');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toast.error(result.Message);
                    }
                })
                .catch(error => {
                    toast.error('Error deactivating user');
                });
            }
        );
    }
    </script>
}
