@model ShoeStore.Areas.Admin.Models.DTOs.UserRoleDTO
@{
    ViewBag.Title = "Manage Roles";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayoutPage.cshtml";
    ViewData["PageTitle"] = ViewBag.PageTitle;
}

<section style="padding: 1rem 1rem 5rem; margin: 0 auto;">
    <div style="max-width: 56rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem;">
        <!-- Back Navigation -->
        <a href="@Url.Action("Index")" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #71717a; text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.2s; width: fit-content;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back to Users
        </a>

        <!-- Main Card -->
        <div style="border-radius: 24px; border: 1px solid #e4e4e7; background: white; padding: 2rem; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);">
            <!-- User Profile Header -->
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #e4e4e7;">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: 700; color: white; flex-shrink: 0;">
                    @Model.FullName.Substring(0, 1).ToUpper()
                </div>
                <div style="flex: 1; min-width: 0;">
                    <h3 style="font-size: 1.25rem; font-weight: 700; color: #18181b; margin: 0 0 0.25rem 0;">@Model.FullName</h3>
                    <p style="font-size: 0.875rem; color: #71717a; margin: 0;">@Model.Email</p>
                </div>
            </div>

            <!-- Roles Section -->
            <div>
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); display: flex; align-items: center; justify-content: center;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h2 style="font-size: 1.25rem; font-weight: 700; color: #18181b; margin: 0;">Assign Roles</h2>
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <div style="border-radius: 12px; border: 1px solid #e4e4e7; background: #fafafa; padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: all 0.2s;">
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span style="font-size: 0.875rem; font-weight: 600; color: #18181b;">@role.RoleName</span>
                                    @if (role.IsAssigned)
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.125rem 0.5rem; border-radius: 9999px; background: #dcfce7; color: #166534; font-size: 0.75rem; font-weight: 600;">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                            Active
                                        </span>
                                    }
                                </div>
                            </div>
                            <div>
                                @if (role.IsAssigned)
                                {
                                    <button type="button" onclick="removeRole(@Model.UserId, @role.RoleID, '@role.RoleName')" style="padding: 0.5rem 1rem; border-radius: 9999px; background: white; color: #ef4444; border: 1px solid #fecaca; cursor: pointer; font-size: 0.875rem; font-weight: 600; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.5rem;" onmouseover="this.style.background='#fef2f2'; this.style.borderColor='#ef4444';" onmouseout="this.style.background='white'; this.style.borderColor='#fecaca';">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 6L6 18M6 6l12 12"/>
                                        </svg>
                                        Remove
                                    </button>
                                }
                                else
                                {
                                    <button type="button" onclick="assignRole(@Model.UserId, @role.RoleID, '@role.RoleName')" style="padding: 0.5rem 1rem; border-radius: 9999px; background: #18181b; color: white; border: none; cursor: pointer; font-size: 0.875rem; font-weight: 600; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.5rem;" onmouseover="this.style.background='#27272a';" onmouseout="this.style.background='#18181b';">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 5v14M5 12h14"/>
                                        </svg>
                                        Assign
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Back Button -->
            <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #e4e4e7;">
                <a href="@Url.Action("Index")" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 9999px; background: white; color: #18181b; border: 1px solid #e4e4e7; text-decoration: none; font-size: 0.875rem; font-weight: 600; transition: all 0.2s;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    Back to Users List
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    a[href*="Index"]:hover {
        color: #18181b !important;
    }

    a[style*="border: 1px solid #e4e4e7"]:hover {
        background: #fafafa !important;
        border-color: #18181b !important;
    }
</style>

@section Scripts {
    <script>
    function assignRole(userId, roleId, roleName) {
        showConfirm(
            'Assign role "' + roleName + '" to this user?',
            'Assign Role',
            function() {
                fetch('@Url.Action("AssignRole")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ userId: userId, roleId: roleId })
                })
                .then(response => response.json())
                .then(result => {
                    if (result.Status) {
                        toast.success(result.Message);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toast.error(result.Message);
                    }
                })
                .catch(error => {
                    toast.error('Error assigning role');
                });
            }
        );
    }

    function removeRole(userId, roleId, roleName) {
        showConfirm(
            'Remove role "' + roleName + '" from this user?',
            'Remove Role',
            function() {
                fetch('@Url.Action("RemoveRole")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ userId: userId, roleId: roleId })
                })
                .then(response => response.json())
                .then(result => {
                    if (result.Status) {
                        toast.success(result.Message);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toast.error(result.Message);
                    }
                })
                .catch(error => {
                    toast.error('Error removing role');
                });
            }
        );
    }
    </script>
}
