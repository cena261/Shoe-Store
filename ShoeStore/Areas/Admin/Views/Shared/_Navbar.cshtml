<aside class="admin-sidebar">
    <div style="padding: 2rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1);">
        <a href="@Url.Action("Index", "Product", new { area = "Admin" })" style="display: flex; align-items: center; text-decoration: none;">
            <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-right: 0.875rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                    <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"></path>
                    <path d="M12 12l8 -4.5"></path>
                    <path d="M12 12l0 9"></path>
                    <path d="M12 12l-8 -4.5"></path>
                </svg>
            </div>
            <div>
                <div style="color: white; font-weight: 700; font-size: 1.125rem; line-height: 1.2;">ShoeStore</div>
                <div style="color: rgba(255,255,255,0.5); font-size: 0.75rem; font-weight: 500;">Admin Panel</div>
            </div>
        </a>
    </div>

    <button onclick="toggleMobileSidebar()" style="display: none; position: absolute; top: 1.5rem; right: 1rem; background: rgba(255,255,255,0.1); border: none; color: white; padding: 0.5rem; border-radius: 6px; cursor: pointer;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
    </button>

    <nav style="padding: 1.5rem 0;">
        <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Product" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"></path>
                <path d="M12 12l8 -4.5"></path>
                <path d="M12 12l0 9"></path>
                <path d="M12 12l-8 -4.5"></path>
            </svg>
            Products
        </a>

        <a href="@Url.Action("Index", "User", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "User" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
                <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                <path d="M21 21v-2a4 4 0 0 0 -3 -3.85"></path>
            </svg>
            Users
        </a>

        <a href="@Url.Action("Index", "Order", new { area = "Admin" })" class="admin-nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Order" ? "active" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path>
                <path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path>
                <path d="M12 12l0 .01"></path>
                <path d="M3 13a20 20 0 0 0 18 0"></path>
            </svg>
            Orders
        </a>
    </nav>

    <div style="margin-top: auto; padding: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1);">
        <div style="display: flex; align-items: center; padding: 0.75rem; background: rgba(255,255,255,0.05); border-radius: 10px; margin-bottom: 1rem;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); display: flex; align-items: center; justify-content: center; margin-right: 0.875rem; font-weight: 700; color: white; font-size: 0.875rem;">
                @{
                    var userEmail = Session["UserEmail"]?.ToString() ?? "Admin";
                    var initial = userEmail.Substring(0, 1).ToUpper();
                }
                @initial
            </div>
            <div style="flex: 1; min-width: 0;">
                <div style="color: white; font-weight: 600; font-size: 0.875rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @userEmail
                </div>
                <div style="color: rgba(255,255,255,0.5); font-size: 0.75rem;">Administrator</div>
            </div>
        </div>

        <button onclick="logout()" class="btn btn-danger" style="width: 100%; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.5rem;">
                <path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2"></path>
                <path d="M9 12h12l-3 -3"></path>
                <path d="M18 15l3 -3"></path>
            </svg>
            Logout
        </button>
    </div>

    <style>
        @@media (max-width: 1024px) {
            .admin-sidebar button[onclick="toggleMobileSidebar()"] {
                display: block !important;
            }
        }
    </style>
</aside>

<script>
function logout() {
    showConfirm(
        'Xác nhận đăng xuất tài khoản?',
        'Logout',
        function() {
            fetch('@Url.Action("Logout", "Account", new { area = "" })', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.Status) {
                    toast.success('Logged out successfully');
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Login", "Account", new { area = "" })';
                    }, 500);
                } else {
                    toast.error('Logout failed');
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Login", "Account", new { area = "" })';
                    }, 500);
                }
            })
            .catch(() => {
                window.location.href = '@Url.Action("Login", "Account", new { area = "" })';
            });
        }
    );
}
</script>
