<header class="navbar navbar-expand-md navbar-overlap d-print-none" data-bs-theme="dark">
    <div class="container-xl">
        <!-- Mobile toggle button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Logo/Brand -->
        <div class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
            <a href="@Url.Action("Index", "Home")" style="color: white; text-decoration: none; font-weight: 600;">
                ShoeStore Admin
            </a>
        </div>

        <!-- Right side items -->
        <div class="navbar-nav flex-row order-md-last">
            <!-- Theme toggle -->
            <div class="nav-item">
                <a href="#" class="nav-link px-0 hide-theme-dark" title="Enable dark mode" id="theme-toggle-dark">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                        <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
                    </svg>
                </a>
                <a href="#" class="nav-link px-0 hide-theme-light" title="Enable light mode" id="theme-toggle-light">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                        <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                        <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
                    </svg>
                </a>
            </div>

            <!-- User profile -->
            <div class="nav-item">
                <div class="d-flex align-items-center lh-1 p-0 px-2">
                    <span class="avatar avatar-sm" style="background-image: url(@Url.Content("~/Areas/Admin/Content/images/admin.png"))"></span>
                    <div class="d-none d-xl-block ps-2">
                        <div>@(Session["UserEmail"] ?? "Admin")</div>
                        <div class="mt-1 small text-secondary">Administrator</div>
                    </div>
                </div>
            </div>

            <!-- Logout button -->
            <div class="nav-item">
                <button onclick="logout()" class="btn btn-outline-danger ms-2" style="height: 36px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2"></path>
                        <path d="M9 12h12l-3 -3"></path>
                        <path d="M18 15l3 -3"></path>
                    </svg>
                    <span class="d-none d-lg-inline ms-1">Logout</span>
                </button>
            </div>
        </div>

        <!-- Mobile menu -->
        <div class="collapse navbar-collapse" id="navbar-menu">
            <div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
                <ul class="navbar-nav">
                    <li class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Dashboard", "Admin", new { area = "Admin" })">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                    <path d="M5 12l-2 0l9 -9l9 9l-2 0"></path>
                                    <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path>
                                    <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"></path>
                                </svg>
                            </span>
                            <span class="nav-link-title">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Product" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Index", "Product", new { area = "Admin" })">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                    <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"></path>
                                    <path d="M12 12l8 -4.5"></path>
                                    <path d="M12 12l0 9"></path>
                                    <path d="M12 12l-8 -4.5"></path>
                                </svg>
                            </span>
                            <span class="nav-link-title">Products</span>
                        </a>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "User" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Index", "User", new { area = "Admin" })">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                    <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
                                    <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    <path d="M21 21v-2a4 4 0 0 0 -3 -3.85"></path>
                                </svg>
                            </span>
                            <span class="nav-link-title">Users</span>
                        </a>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"].ToString() == "Order" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Index", "Order", new { area = "Admin" })">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                                    <path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path>
                                    <path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path>
                                    <path d="M12 12l0 .01"></path>
                                    <path d="M3 13a20 20 0 0 0 18 0"></path>
                                </svg>
                            </span>
                            <span class="nav-link-title">Orders</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>

<script>
function logout() {
    showConfirm(
        'Are you sure you want to logout?',
        'Logout',
        function() {
            fetch('@Url.Action("Logout", "Account", new { area = "" })', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(result => {
                if (result.Status) {
                    toast.success('Logged out successfully');
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Login", "Account", new { area = "" })';
                    }, 500);
                } else {
                    toast.error('Logout failed');
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Login", "Account", new { area = "" })';
                    }, 500);
                }
            })
            .catch(() => {
                window.location.href = '@Url.Action("Login", "Account", new { area = "" })';
            });
        }
    );
}
</script>
