@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayoutPage.cshtml";
}

<section style="padding: 5rem 1rem; margin: 0 auto;">
    <div style="max-width: 80rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;">

        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <p style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.35em; color: #a1a1aa; font-weight: 600; margin: 0;">Admin Panel</p>
            <h1 style="font-size: 3.5rem; font-weight: 800; margin: 0; line-height: 1; background: linear-gradient(135deg, #18181b 0%, #52525b 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Admin Dashboard</h1>
            <p style="font-size: 1.125rem; color: #71717a; margin: 0; max-width: 42rem;">
                Welcome to the admin panel. Manage your store from here.
            </p>
        </div>

        <div style="border-radius: 24px; border: 1px solid #e4e4e7; background: white; padding: 2.5rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05); position: relative; overflow: hidden;">
            <div style="position: absolute; top: -50px; right: -50px; width: 200px; height: 200px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); opacity: 0.03; border-radius: 50%;"></div>

            <div style="position: relative;">
                <h2 style="font-size: 1.875rem; font-weight: 800; margin: 0; color: #18181b;">Management Modules</h2>
                <p style="margin-top: 0.5rem; font-size: 1rem; color: #71717a; margin-bottom: 0;">
                    Available admin features
                </p>

                <div style="margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">

                    <a href="@Url.Action("Index", "Product", new { area = "Admin" })" style="border-radius: 9999px; border: 1.5px solid #e4e4e7; background: white; padding: 1.5rem 2rem; text-decoration: none; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column; gap: 0.5rem; position: relative; overflow: hidden;">
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); opacity: 0; transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);"></div>
                        <div style="position: relative; display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); display: flex; align-items: center; justify-content: center;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                            </div>
                            <div style="font-size: 1.125rem; font-weight: 700; color: #18181b;">Product Management</div>
                        </div>
                        <div style="position: relative; font-size: 0.9375rem; color: #71717a; margin-left: 3.25rem;">
                            Manage products, variants, and images
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "User", new { area = "Admin" })" style="border-radius: 9999px; border: 1.5px solid #e4e4e7; background: white; padding: 1.5rem 2rem; text-decoration: none; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column; gap: 0.5rem; position: relative; overflow: hidden;">
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); opacity: 0; transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);"></div>
                        <div style="position: relative; display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%); display: flex; align-items: center; justify-content: center;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                            <div style="font-size: 1.125rem; font-weight: 700; color: #18181b;">User Management</div>
                        </div>
                        <div style="position: relative; font-size: 0.9375rem; color: #71717a; margin-left: 3.25rem;">
                            Manage users, roles, and permissions
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Order", new { area = "Admin" })" style="border-radius: 9999px; border: 1.5px solid #e4e4e7; background: white; padding: 1.5rem 2rem; text-decoration: none; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column; gap: 0.5rem; position: relative; overflow: hidden;">
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, #10b981 0%, #059669 100%); opacity: 0; transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);"></div>
                        <div style="position: relative; display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); display: flex; align-items: center; justify-content: center;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </div>
                            <div style="font-size: 1.125rem; font-weight: 700; color: #18181b;">Order Management</div>
                        </div>
                        <div style="position: relative; font-size: 0.9375rem; color: #71717a; margin-left: 3.25rem;">
                            Manage orders and track statuses
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
a[href*="Product"]:hover, a[href*="User"]:hover, a[href*="Order"]:hover {
    border-color: #18181b !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
}

a[href*="Product"]:hover > div:first-child,
a[href*="User"]:hover > div:first-child,
a[href*="Order"]:hover > div:first-child {
    opacity: 0.08;
}
</style>
