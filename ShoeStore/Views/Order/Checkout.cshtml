
@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<div class="checkout-container">
    <div class="checkout-form">
        <h2>Customer Details</h2>

        <!-- Address Selector (only for logged-in users with saved addresses) -->
        <div id="address-selector" style="display: none; margin-bottom: 1.5rem;">
            <label for="saved-addresses" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Saved Addresses</label>
            <select id="saved-addresses" class="input" onchange="fillAddressForm(this.value)">
                <option value="">Select an address</option>
            </select>
        </div>

        <form id="checkout-form">
            <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" class="input" required>
                <div class="form-error" id="email-error"></div>
            </div>

            <div class="form-group">
                <label for="fullName">Full Name *</label>
                <input type="text" id="fullName" name="fullName" class="input" required>
                <div class="form-error" id="fullName-error"></div>
            </div>

            <div class="form-group">
                <label for="phone">Phone Number *</label>
                <input type="tel" id="phone" name="phone" class="input" required>
                <div class="form-error" id="phone-error"></div>
            </div>

            <div class="form-group">
                <label for="tenDuong">Street Address *</label>
                <input type="text" id="tenDuong" name="tenDuong" class="input" required>
                <div class="form-error" id="tenDuong-error"></div>
            </div>

            <div class="form-group">
                <label for="xaQuan">Ward/District *</label>
                <input type="text" id="xaQuan" name="xaQuan" class="input" required>
                <div class="form-error" id="xaQuan-error"></div>
            </div>

            <div class="form-group">
                <label for="tinhThanh">Province/City *</label>
                <select id="tinhThanh" name="tinhThanh" class="input" required>
                    <option value="">Select province/city</option>
                    <option value="Bà Rịa - Vũng Tàu">Bà Rịa - Vũng Tàu</option>
                    <option value="Bắc Giang">Bắc Giang</option>
                    <option value="Bắc Ninh">Bắc Ninh</option>
                    <option value="Bình Định">Bình Định</option>
                    <option value="Bình Thuận">Bình Thuận</option>
                    <option value="Cao Bằng">Cao Bằng</option>
                    <option value="Đà Nẵng">Đà Nẵng</option>
                    <option value="Điện Biên">Điện Biên</option>
                    <option value="Đồng Nai">Đồng Nai</option>
                    <option value="Hà Giang">Hà Giang</option>
                    <option value="Hà Nội">Hà Nội</option>
                    <option value="Hà Tĩnh">Hà Tĩnh</option>
                    <option value="Hòa Bình">Hòa Bình</option>
                    <option value="Hồ Chí Minh">Hồ Chí Minh</option>
                    <option value="Huế">Huế</option>
                    <option value="Khánh Hòa">Khánh Hòa</option>
                    <option value="Lai Châu">Lai Châu</option>
                    <option value="Lạng Sơn">Lạng Sơn</option>
                    <option value="Long An">Long An</option>
                    <option value="Nghệ An">Nghệ An</option>
                    <option value="Ninh Thuận">Ninh Thuận</option>
                    <option value="Phú Yên">Phú Yên</option>
                    <option value="Quảng Bình">Quảng Bình</option>
                    <option value="Quảng Nam">Quảng Nam</option>
                    <option value="Quảng Ngãi">Quảng Ngãi</option>
                    <option value="Quảng Ninh">Quảng Ninh</option>
                    <option value="Quảng Trị">Quảng Trị</option>
                    <option value="Sơn La">Sơn La</option>
                    <option value="Thái Nguyên">Thái Nguyên</option>
                </select>
                <div class="form-error" id="tinhThanh-error"></div>
            </div>
        </form>
    </div>

    <!-- Order Summary -->
    <div class="checkout-summary">
        <h2>Order Summary</h2>

        <div id="order-items" style="margin-bottom: 1.5rem;">
            <!-- Xy ly danh sach order  -->
        </div>

        <div class="summary-item">
            <span>Subtotal:</span>
            <span id="subtotal">0₫</span>
        </div>

        <div class="summary-item">
            <span>Shipping:</span>
            <span style="color: #10b981;">FREE</span>
        </div>

        <div class="summary-item" id="discount-row" style="display: none;">
            <span>Discount:</span>
            <span id="discount-amount" style="color: #10b981;">-0₫</span>
        </div>

        <div class="summary-total">
            <span>Total:</span>
            <span id="total">0₫</span>
        </div>

        <div class="discount-code">
            <input type="text" id="discount-code-input" class="input" placeholder="Discount code">
            <button class="btn" onclick="applyDiscount()" style="width: 100%; margin-top: 0.5rem;">
                Apply Code
            </button>
            <div id="discount-message" style="margin-top: 0.5rem; font-size: 0.875rem;"></div>
        </div>

        <button class="btn" onclick="proceedToPayment()" style="width: 100%; margin-top: 1.5rem; padding: 1rem;">
            Proceed to Payment
        </button>
    </div>
</div>

<div id="confirmation-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: white; padding: 2.5rem; border-radius: 0.5rem; max-width: 500px; margin: 2rem; position: relative;">
        <button onclick="closeModal()" style="position: absolute; top: 1.25rem; right: 1.25rem;" class="btn-icon">
            ✕
        </button>
        <h1 style="text-align: center; font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">
            Are you sure?
        </h1>
        <p style="margin-bottom: 1.5rem;">
            Your cart will be cleared and you will be redirected to the order confirmation page.
        </p>
        <button class="btn" onclick="confirmPayment()" style="width: 100%; padding: 0.75rem;">
            Confirm Payment
        </button>
    </div>
</div>

@section Scripts {
    <script>
    let discountApplied = false;
    let discountAmount = 0;
    let userAddresses = [];
    let isLoggedIn = false;

    async function loadUserData() {
      const user = cart.getUser();
      isLoggedIn = user && user.loggedIn === true;

      if (isLoggedIn) {
        document.getElementById('email').value = user.email || '';
        document.getElementById('fullName').value = user.fullName || '';
        document.getElementById('phone').value = user.phone || '';

        await loadUserAddresses();
      }
    }

    async function loadUserAddresses() {
      try {
        const response = await fetch('/Account/GetUserAddresses');
        const result = await response.json();

        if (result.Status && result.Addresses && result.Addresses.length > 0) {
          userAddresses = result.Addresses;

          const selector = document.getElementById('saved-addresses');
          const addressSelectorDiv = document.getElementById('address-selector');

          userAddresses.forEach(addr => {
            const option = document.createElement('option');
            option.value = addr.AddressID;
            option.textContent = `${addr.FullName} - ${addr.TenDuong}, ${addr.XaQuan}, ${addr.TinhThanh}${addr.IsDefault ? ' (Default)' : ''}`;
            selector.appendChild(option);
          });

          addressSelectorDiv.style.display = 'block';

          const defaultAddress = userAddresses.find(a => a.IsDefault);
          if (defaultAddress) {
            fillAddressForm(defaultAddress.AddressID);
            selector.value = defaultAddress.AddressID;
          }
        }
      } catch (error) {
        console.error('Failed to load addresses:', error);
      }
    }

    function fillAddressForm(addressId) {
      if (!addressId) {
        document.getElementById('fullName').value = cart.getUser()?.fullName || '';
        document.getElementById('phone').value = cart.getUser()?.phone || '';
        document.getElementById('tenDuong').value = '';
        document.getElementById('xaQuan').value = '';
        document.getElementById('tinhThanh').value = '';
        return;
      }

      const address = userAddresses.find(a => a.AddressID == addressId);
      if (address) {
        document.getElementById('fullName').value = address.FullName;
        document.getElementById('phone').value = address.Phone;
        document.getElementById('tenDuong').value = address.TenDuong;
        document.getElementById('xaQuan').value = address.XaQuan;
        document.getElementById('tinhThanh').value = address.TinhThanh;
      }
    }

    async function loadOrderSummary() {
      await cart.waitReady();

      if (cart.items.length === 0) {
        window.location.href = '/Home/Index';
        return;
      }

      const orderItems = document.getElementById('order-items');

      orderItems.innerHTML = cart.items.map(item => `
        <div style="display: flex; gap: 1rem; margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #e5e7eb;">
          <img src="${item.images[0]}" alt="${item.name}" style="width: 60px; height: 60px; object-fit: cover;">
          <div style="flex: 1;">
            <h4 style="font-weight: 600; margin: 0;">${item.name}</h4>
            <p style="font-size: 0.875rem; color: #6b7280; margin: 0.25rem 0;">${item.colorName} - Size: EU ${item.size}</p>
            <p style="font-size: 0.875rem; color: #6b7280; margin: 0;">Qty: ${item.quantity}</p>
          </div>
          <div style="text-align: right;">
            <p style="font-weight: 600; margin: 0;">${formatCurrency((item.promotionPrice || item.price) * item.quantity)}</p>
          </div>
        </div>
      `).join('');

      updateTotals();
    }

    function updateTotals() {
      const subtotal = cart.getTotal();
      const total = subtotal - discountAmount;

      document.getElementById('subtotal').textContent = formatCurrency(subtotal);
      document.getElementById('total').textContent = formatCurrency(total);

      if (discountApplied) {
        document.getElementById('discount-row').style.display = 'flex';
        document.getElementById('discount-amount').textContent = `-${formatCurrency(discountAmount)}`;
      }
    }

    function applyDiscount() {
      const code = document.getElementById('discount-code-input').value.trim();
      const messageEl = document.getElementById('discount-message');

      if (!code) {
        messageEl.textContent = 'Please enter a discount code';
        messageEl.style.color = '#ef4444';
        return;
      }

      if (code.toUpperCase() === 'SAVE10') {
        discountApplied = true;
        discountAmount = Math.round(cart.getTotal() * 0.1);
        messageEl.textContent = 'Discount applied successfully!';
        messageEl.style.color = '#10b981';
        updateTotals();
      } else {
        messageEl.textContent = 'Invalid discount code';
        messageEl.style.color = '#ef4444';
      }
    }

    function proceedToPayment() {
      if (!validateForm('checkout-form')) {
        toast.warning('Please fill in all required fields correctly');
        return;
      }

      const modal = document.getElementById('confirmation-modal');
      modal.style.display = 'flex';

      const { animate } = window.Motion;
      const modalContent = modal.querySelector('div');
      animate(modalContent,
        { scale: [0.9, 1], opacity: [0, 1] },
        { duration: 0.3 }
      );
    }

    function closeModal() {
      const modal = document.getElementById('confirmation-modal');
      modal.style.display = 'none';
    }

    async function confirmPayment() {
      const formData = new FormData(document.getElementById('checkout-form'));
      const customer = Object.fromEntries(formData);

      const orderRequest = {
        RequireAuth: false,
        TotalAmount: cart.getTotal() - discountAmount,
        ShippingName: customer.fullName,
        ShippingPhone: customer.phone,
        ShippingTenDuong: customer.tenDuong,
        ShippingXaQuan: customer.xaQuan,
        ShippingTinhThanh: customer.tinhThanh,
        Items: cart.items.map(item => ({
          VariantID: item.variantId,
          Quantity: item.quantity,
          UnitPrice: item.promotionPrice || item.price
        }))
      };

      try {
        const response = await fetch('/api/Order/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(orderRequest)
        });

        const result = await response.json();

        if (result.Status) {
          const orderData = {
            orderId: result.OrderID,
            customer: customer,
            items: cart.items,
            subtotal: cart.getTotal(),
            discount: discountAmount,
            total: cart.getTotal() - discountAmount,
            date: new Date().toISOString()
          };

          sessionStorage.setItem('lastOrder', JSON.stringify(orderData));

          cart.clearCart();

          window.location.href = '/Order/Success';
        } else {
          toast.error(result.Message || 'Failed to create order');
          closeModal();
        }
      } catch (error) {
        console.error('Order creation failed:', error);
        toast.error('An error occurred. Please try again.');
        closeModal();
      }
    }

    document.addEventListener('DOMContentLoaded', async function() {
      await cart.waitReady();
      await loadUserData();
      await loadOrderSummary();

      const { animate } = window.Motion;

      animate('.checkout-form',
        { opacity: [0, 1], x: [-20, 0] },
        { duration: 0.6, ease: [0.6, 0.01, -0.05, 0.9] }
      );

      animate('.checkout-summary',
        { opacity: [0, 1], x: [20, 0] },
        { duration: 0.6, delay: 0.2, ease: [0.6, 0.01, -0.05, 0.9] }
      );
    });

    document.getElementById('confirmation-modal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeModal();
      }
    });
    </script>
}


