@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

@section Styles {
    <style>
    @@keyframes slideDown {
      0% {
        opacity: 0;
        transform: translateY(-50px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    #forgot-password-content {
      animation-name: slideDown;
      animation-duration: 0.8s;
      animation-timing-function: cubic-bezier(0.6, 0.01, -0.05, 0.9);
      animation-fill-mode: forwards;
      opacity: 0;
    }

    .step {
      display: none;
    }

    .step.active {
      display: block;
    }

    .code-input {
      font-size: 24px;
      font-weight: bold;
      text-align: center;
      letter-spacing: 10px;
      width: 100%;
    }

    #password::-ms-reveal,
    #password::-ms-clear,
    #confirmPassword::-ms-reveal,
    #confirmPassword::-ms-clear {
      display: none;
    }
    </style>
}

<div class="flex flex-col items-center justify-center" style="min-height: 80vh;">
    <div class="-mt-24 w-full p-4 sm:mt-0 sm:p-7 2xl:-mt-36" id="forgot-password-content">

        <!-- 1. dien mail -->
        <div class="step active" id="step1">
            <h1 class="text-center text-4xl font-semibold leading-tight xl:text-6xl">
                Forgot Your Password?
            </h1>
            <p class="text-center mt-4 text-gray-600">
                No worries! Enter your email and we'll send you a verification code.
            </p>

            <div class="w-full text-center mt-4">
                <a class="underline" href="/Account/Login">Remember your password? Login here!</a>
            </div>

            <div class="mt-10">
                <div class="flex w-full justify-center">
                    <form class="flex w-160 flex-col gap-1" id="email-form">
                        <label class="flex flex-col">
                            <span class="text-lg font-semibold">Email</span>
                            <input type="email"
                                   class="input"
                                   placeholder="Enter your email..."
                                   id="email"
                                   name="email"
                                   value="" />
                            <div class="h-4 text-xs italic text-red-500" id="email-error"></div>
                        </label>

                        <div class="h-4 text-xs italic text-green-600 text-center" id="email-success"></div>
                        <div class="h-4 text-xs italic text-red-500 text-center" id="email-form-error"></div>

                        <button type="submit" class="btn mt-1 rounded-md py-2 h-10">
                            Send Verification Code
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- 2. nhap ma -->
        <div class="step" id="step2">
            <h1 class="text-center text-4xl font-semibold leading-tight xl:text-6xl">
                Verify Your Email
            </h1>
            <p class="text-center mt-4 text-gray-600">
                We've sent a 6-digit code to <strong id="user-email"></strong>
            </p>
            <p class="text-center mt-2 text-sm text-gray-500">
                The code will expire in 15 minutes.
            </p>

            <div class="mt-10">
                <div class="flex w-full justify-center">
                    <form class="flex w-160 flex-col gap-1" id="code-form">
                        <label class="flex flex-col">
                            <span class="text-lg font-semibold">Verification Code</span>
                            <input type="text"
                                   class="input code-input"
                                   placeholder="000000"
                                   id="code"
                                   name="code"
                                   maxlength="6"
                                   pattern="[0-9]{6}" />
                            <div class="h-4 text-xs italic text-red-500" id="code-error"></div>
                        </label>

                        <div class="h-4 text-xs italic text-green-600 text-center" id="code-success"></div>
                        <div class="h-4 text-xs italic text-red-500 text-center" id="code-form-error"></div>

                        <button type="submit" class="btn mt-1 rounded-md py-2 h-10">
                            Verify Code
                        </button>

                        <button type="button" class="btn-secondary mt-2 rounded-md py-2 h-10" id="resend-btn" onclick="resendCode()">
                            Resend Code (60s)
                        </button>

                        <button type="button" class="btn-secondary mt-2 rounded-md py-2 h-10" onclick="resetToStep1()">
                            Back
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- 3. reset pass -->
        <div class="step" id="step3">
            <h1 class="text-center text-4xl font-semibold leading-tight xl:text-6xl">
                Reset Your Password
            </h1>
            <p class="text-center mt-4 text-gray-600">
                Enter your new password below.
            </p>

            <div class="mt-10">
                <div class="flex w-full justify-center">
                    <form class="flex w-160 flex-col gap-1" id="password-form">
                        <label class="flex flex-col">
                            <span class="text-lg font-semibold">New Password</span>
                            <div class="relative w-full">
                                <input type="password"
                                       class="input w-full"
                                       placeholder="Enter new password..."
                                       id="password"
                                       name="password"
                                       style="padding-right: 2.5rem;" />
                                <button class="btn-icon absolute right-0 h-full px-2" type="button" onclick="togglePassword('password', 'eye-icon-1')">
                                    <svg stroke="currentColor"
                                         fill="currentColor"
                                         stroke-width="0"
                                         viewBox="0 0 1024 1024"
                                         height="1em"
                                         width="1em"
                                         xmlns="http://www.w3.org/2000/svg"
                                         id="eye-icon-1">
                                        <path d="M942.2 486.2C847.4 286.5 704.1 186 512 186c-192.2 0-335.4 100.5-430.2 300.3a60.3 60.3 0 0 0 0 51.5C176.6 737.5 319.9 838 512 838c192.2 0 335.4-100.5 430.2-300.3 7.7-16.2 7.7-35 0-51.5zM512 766c-161.3 0-279.4-81.8-362.7-254C232.6 339.8 350.7 258 512 258c161.3 0 279.4 81.8 362.7 254C791.5 684.2 673.4 766 512 766zm-4-430c-97.2 0-176 78.8-176 176s78.8 176 176 176 176-78.8 176-176-78.8-176-176-176zm0 288c-61.9 0-112-50.1-112-112s50.1-112 112-112 112 50.1 112 112-50.1 112-112 112z"></path>
                                    </svg>
                                </button>
                            </div>
                            <div class="h-4 text-xs italic text-red-500" id="password-error"></div>
                        </label>

                        <label class="flex flex-col">
                            <span class="text-lg font-semibold">Confirm Password</span>
                            <div class="relative w-full">
                                <input type="password"
                                       class="input w-full"
                                       placeholder="Confirm new password..."
                                       id="confirmPassword"
                                       name="confirmPassword"
                                       style="padding-right: 2.5rem;" />
                                <button class="btn-icon absolute right-0 h-full px-2" type="button" onclick="togglePassword('confirmPassword', 'eye-icon-2')">
                                    <svg stroke="currentColor"
                                         fill="currentColor"
                                         stroke-width="0"
                                         viewBox="0 0 1024 1024"
                                         height="1em"
                                         width="1em"
                                         xmlns="http://www.w3.org/2000/svg"
                                         id="eye-icon-2">
                                        <path d="M942.2 486.2C847.4 286.5 704.1 186 512 186c-192.2 0-335.4 100.5-430.2 300.3a60.3 60.3 0 0 0 0 51.5C176.6 737.5 319.9 838 512 838c192.2 0 335.4-100.5 430.2-300.3 7.7-16.2 7.7-35 0-51.5zM512 766c-161.3 0-279.4-81.8-362.7-254C232.6 339.8 350.7 258 512 258c161.3 0 279.4 81.8 362.7 254C791.5 684.2 673.4 766 512 766zm-4-430c-97.2 0-176 78.8-176 176s78.8 176 176 176 176-78.8 176-176-78.8-176-176-176zm0 288c-61.9 0-112-50.1-112-112s50.1-112 112-112 112 50.1 112 112-50.1 112-112 112z"></path>
                                    </svg>
                                </button>
                            </div>
                            <div class="h-4 text-xs italic text-red-500" id="confirm-password-error"></div>
                        </label>

                        <div class="h-4 text-xs italic text-green-600 text-center" id="password-success"></div>
                        <div class="h-4 text-xs italic text-red-500 text-center" id="password-form-error"></div>

                        <button type="submit" class="btn mt-1 rounded-md py-2 h-10">
                            Reset Password
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
    let userEmail = '';
    let verificationCode = '';
    let resendTimer = 0;
    let resendInterval = null;

    function goToStep(step) {
      document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
      document.getElementById('step' + step).classList.add('active');

      if (step === 2) {
        startResendTimer();
      }
    }

    function resetToStep1() {
      document.getElementById('email').value = '';
      document.getElementById('code').value = '';
      userEmail = '';
      verificationCode = '';
      clearResendTimer();
      goToStep(1);
    }

    function startResendTimer() {
      resendTimer = 60;
      const resendBtn = document.getElementById('resend-btn');
      resendBtn.disabled = true;
      resendBtn.textContent = 'Resend Code (' + resendTimer + 's)';

      if (resendInterval) clearInterval(resendInterval);

      resendInterval = setInterval(() => {
        resendTimer--;
        if (resendTimer <= 0) {
          clearInterval(resendInterval);
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Code';
        } else {
          resendBtn.textContent = 'Resend Code (' + resendTimer + 's)';
        }
      }, 1000);
    }

    function clearResendTimer() {
      if (resendInterval) {
        clearInterval(resendInterval);
        resendInterval = null;
      }
      resendTimer = 0;
    }

    async function resendCode() {
      if (!userEmail) return;

      document.getElementById('code-form-error').textContent = '';
      document.getElementById('code-success').textContent = '';

      const resendBtn = document.getElementById('resend-btn');
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending...';

      try {
        const response = await fetch('/Account/ForgotPassword', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ Email: userEmail })
        });

        const result = await response.json();

        if (result.Status) {
          document.getElementById('code-success').textContent = 'New code sent to your email!';
          startResendTimer();
        } else {
          document.getElementById('code-form-error').textContent = result.Message;
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Code';
        }
      } catch (error) {
        document.getElementById('code-form-error').textContent = 'An error occurred. Please try again.';
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend Code';
      }
    }

    function togglePassword(inputId, iconId) {
      const passwordInput = document.getElementById(inputId);
      const eyeIcon = document.getElementById(iconId);

      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.innerHTML = '<path d="M942.2 486.2Q889.47 375.11 816.7 296l-227.1 227.1A176.09 176.09 0 0 1 512 552q-90.67 0-155.39-64.73T291.88 332q0-82.69 53.5-145.84L149.6 390.4a60.29 60.29 0 0 1-85.2 0 60.29 60.29 0 0 1 0-85.2l714.1-714.1a60.29 60.29 0 0 1 85.2 0 60.29 60.29 0 0 1 0 85.2L539 1l2.5 2.5C723.8 191.1 857.5 325.9 942.2 486.2zM878.43 165.1L165.1 878.43l-.01-.02.01.02a60.29 60.29 0 0 1-85.19 0 60.29 60.29 0 0 1 0-85.19L793.24 79.91a60.29 60.29 0 0 1 85.19 0 60.29 60.29 0 0 1 0 85.19z"></path>';
      } else {
        passwordInput.type = 'password';
        eyeIcon.innerHTML = '<path d="M942.2 486.2C847.4 286.5 704.1 186 512 186c-192.2 0-335.4 100.5-430.2 300.3a60.3 60.3 0 0 0 0 51.5C176.6 737.5 319.9 838 512 838c192.2 0 335.4-100.5 430.2-300.3 7.7-16.2 7.7-35 0-51.5zM512 766c-161.3 0-279.4-81.8-362.7-254C232.6 339.8 350.7 258 512 258c161.3 0 279.4 81.8 362.7 254C791.5 684.2 673.4 766 512 766zm-4-430c-97.2 0-176 78.8-176 176s78.8 176 176 176 176-78.8 176-176-78.8-176-176-176zm0 288c-61.9 0-112-50.1-112-112s50.1-112 112-112 112 50.1 112 112-50.1 112-112 112z"></path>';
      }
    }

    // 1. send ma
    document.getElementById('email-form').addEventListener('submit', async function(e) {
      e.preventDefault();

      document.getElementById('email-error').textContent = '';
      document.getElementById('email-form-error').textContent = '';
      document.getElementById('email-success').textContent = '';

      const email = document.getElementById('email').value;

      if (!email) {
        document.getElementById('email-error').textContent = 'Required';
        return;
      }

      if (!validateEmail(email)) {
        document.getElementById('email-error').textContent = 'Invalid email';
        return;
      }

      const submitBtn = e.target.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const response = await fetch('/Account/ForgotPassword', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ Email: email })
        });

        const result = await response.json();

        if (result.Status) {
          userEmail = email;
          document.getElementById('user-email').textContent = email;
          document.getElementById('email-success').textContent = result.Message;
          setTimeout(() => goToStep(2), 1500);
        } else {
          document.getElementById('email-form-error').textContent = result.Message;
        }
      } catch (error) {
        document.getElementById('email-form-error').textContent = 'An error occurred. Please try again.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Verification Code';
      }
    });

    // 2. verify ma
    document.getElementById('code-form').addEventListener('submit', async function(e) {
      e.preventDefault();

      document.getElementById('code-error').textContent = '';
      document.getElementById('code-form-error').textContent = '';
      document.getElementById('code-success').textContent = '';

      const code = document.getElementById('code').value;

      if (!code) {
        document.getElementById('code-error').textContent = 'Required';
        return;
      }

      if (code.length !== 6 || !/^\d{6}$/.test(code)) {
        document.getElementById('code-error').textContent = 'Code must be 6 digits';
        return;
      }

      const submitBtn = e.target.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Verifying...';

      try {
        const response = await fetch('/Account/VerifyResetCode', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            Email: userEmail,
            Code: code
          })
        });

        const result = await response.json();

        if (result.Status) {
          verificationCode = code;
          document.getElementById('code-success').textContent = result.Message;
          setTimeout(() => goToStep(3), 1500);
        } else {
          document.getElementById('code-form-error').textContent = result.Message;
        }
      } catch (error) {
        document.getElementById('code-form-error').textContent = 'An error occurred. Please try again.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Verify Code';
      }
    });

    // 3. reset pass
    document.getElementById('password-form').addEventListener('submit', async function(e) {
      e.preventDefault();

      document.getElementById('password-error').textContent = '';
      document.getElementById('confirm-password-error').textContent = '';
      document.getElementById('password-form-error').textContent = '';
      document.getElementById('password-success').textContent = '';

      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      let hasError = false;

      if (!password) {
        document.getElementById('password-error').textContent = 'Required';
        hasError = true;
      } else if (password.length < 6) {
        document.getElementById('password-error').textContent = 'Password must be at least 6 characters';
        hasError = true;
      }

      if (!confirmPassword) {
        document.getElementById('confirm-password-error').textContent = 'Required';
        hasError = true;
      } else if (password !== confirmPassword) {
        document.getElementById('confirm-password-error').textContent = 'Passwords do not match';
        hasError = true;
      }

      if (hasError) return;

      const submitBtn = e.target.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Resetting...';

      try {
        const response = await fetch('/Account/ResetPassword', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            Email: userEmail,
            Code: verificationCode,
            NewPassword: password
          })
        });

        const result = await response.json();

        if (result.Status) {
          document.getElementById('password-success').textContent = result.Message + ' Redirecting to login...';
          setTimeout(() => {
            window.location.href = '/Account/Login';
          }, 2000);
        } else {
          document.getElementById('password-form-error').textContent = result.Message;
          submitBtn.disabled = false;
          submitBtn.textContent = 'Reset Password';
        }
      } catch (error) {
        document.getElementById('password-form-error').textContent = 'An error occurred. Please try again.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Reset Password';
      }
    });

    document.getElementById('code').addEventListener('input', function(e) {
      this.value = this.value.replace(/[^0-9]/g, '');
    });
    </script>
}
