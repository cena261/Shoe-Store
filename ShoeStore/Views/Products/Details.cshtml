@{
    ViewBag.Title = "Product Details";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<div class="product-detail-container">
    <div class="product-detail-content">
        <div class="product-gallery">
            <div class="main-image-container">
                <img id="main-image" src="" alt="Product Image" />
                <button class="gallery-nav prev" onclick="previousImage()" aria-label="Ảnh trước">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </button>
                <button class="gallery-nav next" onclick="nextImage()" aria-label="Ảnh kế tiếp">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="thumbnail-container" id="thumbnail-container"></div>
        </div>

        <div class="product-info">
            <div class="product-info-header">
                <h1 id="product-name" class="product-title"></h1>
                <p id="product-category" class="product-category"></p>
            </div>

            <div id="product-price" class="product-price"></div>

            <div class="color-selection">
                <div class="color-header">
                    <span>Chọn màu</span>
                    <span id="selected-color-name" class="selected-color-name"></span>
                </div>
                <div id="color-options" class="color-options"></div>
            </div>

            <div class="size-selection">
                <div class="size-header">
                    <span>Chọn Size</span>
                    <button class="size-guide-btn" onclick="openSizeGuide()">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M10 2C14.4183 2 18 5.58172 18 10C18 14.4183 14.4183 18 10 18C5.58172 18 2 14.4183 2 10C2 5.58172 5.58172 2 10 2Z" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M10 6V10L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        Hướng dẫn chọn Size
                    </button>
                </div>
                <div id="size-options" class="size-options"></div>
            </div>

            <button id="add-to-bag-btn" class="add-to-bag-btn" onclick="addToBag()" disabled>
                Thêm vào giỏ hàng
            </button>

            <div class="product-description">
                <h3>Mô tả sản phẩm</h3>
                <p id="product-description-text"></p>
            </div>
        </div>
    </div>
</div>

<div id="size-guide-modal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Bảng Size</h2>
            <button class="modal-close" onclick="closeSizeGuide()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="size-chart-container">
                <table class="size-chart-table">
                    <tbody>
                        <tr>
                            <th>US – Men's</th>
                            <td>3.5</td><td>4</td><td>4.5</td><td>5</td><td>5.5</td><td>6</td><td>6.5</td><td>7</td><td>7.5</td><td>8</td><td>8.5</td><td>9</td><td>9.5</td><td>10</td><td>10.5</td><td>11</td><td>11.5</td><td>12</td><td>12.5</td><td>13</td><td>13.5</td><td>14</td><td>14.5</td><td>15</td>
                        </tr>
                        <tr>
                            <th>US – Women's</th>
                            <td>5</td><td>5.5</td><td>6</td><td>6.5</td><td>7</td><td>7.5</td><td>8</td><td>8.5</td><td>9</td><td>9.5</td><td>10</td><td>10.5</td><td>11</td><td>11.5</td><td>12</td><td>12.5</td><td>13</td><td>13.5</td><td>14</td><td>14.5</td><td>15</td><td>15.5</td><td>16</td><td>16.5</td>
                        </tr>
                        <tr>
                            <th>UK</th>
                            <td>3</td><td>3.5</td><td>4</td><td>4.5</td><td>5</td><td>5.5</td><td>6</td><td>6</td><td>6.5</td><td>7</td><td>7.5</td><td>8</td><td>8.5</td><td>9</td><td>9.5</td><td>10</td><td>10.5</td><td>11</td><td>11.5</td><td>12</td><td>12.5</td><td>13</td><td>13.5</td><td>14</td>
                        </tr>
                        <tr>
                            <th>EU</th>
                            <td>35.5</td><td>36</td><td>36.5</td><td>37.5</td><td>38</td><td>38.5</td><td>39</td><td>40</td><td>40.5</td><td>41</td><td>42</td><td>42.5</td><td>43</td><td>44</td><td>44.5</td><td>45</td><td>45.5</td><td>46</td><td>47</td><td>47.5</td><td>48</td><td>48.5</td><td>49</td><td>49.5</td>
                        </tr>
                        <tr>
                            <th>CM</th>
                            <td>21.6</td><td>22</td><td>22.4</td><td>22.9</td><td>23.3</td><td>23.7</td><td>24.1</td><td>24.5</td><td>25</td><td>25.4</td><td>25.8</td><td>26.2</td><td>26.7</td><td>27.1</td><td>27.5</td><td>27.9</td><td>28.3</td><td>28.8</td><td>29.2</td><td>29.6</td><td>30</td><td>30.5</td><td>30.9</td><td>31.3</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .product-detail-container {
        max-width: 1920px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .product-detail-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Image Gallery */
    .product-gallery {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .main-image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        background: #f5f5f5;
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .main-image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .gallery-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.9);
        border: none;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s;
        z-index: 10;
    }

    .main-image-container:hover .gallery-nav {
        opacity: 1;
    }

    .gallery-nav:hover {
        background: white;
    }

    .gallery-nav.prev {
        left: 1rem;
    }

    .gallery-nav.next {
        right: 1rem;
    }

    .thumbnail-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 0.5rem;
    }

    .thumbnail-item {
        aspect-ratio: 1;
        background: #f5f5f5;
        border-radius: 0.25rem;
        overflow: hidden;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.2s;
    }

    .thumbnail-item:hover {
        border-color: #ccc;
    }

    .thumbnail-item.active {
        border-color: #000;
    }

    .thumbnail-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Product Info */
    .product-info {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .product-info-header {
        padding-bottom: 1rem;
        border-bottom: 1px solid #e5e5e5;
    }

    .product-title {
        font-size: 2rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }

    .product-category {
        font-size: 1rem;
        color: #757575;
        margin: 0;
    }

    .product-price {
        font-size: 1.5rem;
        font-weight: 500;
    }

    /* Color Selection */
    .color-selection {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .color-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 500;
    }

    .selected-color-name {
        color: #757575;
        font-weight: 400;
    }

    .color-options {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .color-option {
        width: 80px;
        height: 80px;
        border: 2px solid #e5e5e5;
        border-radius: 0.5rem;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.2s;
    }

    .color-option:hover {
        border-color: #757575;
    }

    .color-option.active {
        border-color: #000;
        box-shadow: 0 0 0 1px #000;
    }

    .color-option.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .color-option img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Size Selection */
    .size-selection {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .size-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 500;
    }

    .size-guide-btn {
        background: none;
        border: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        color: #757575;
        font-size: 0.875rem;
        transition: color 0.2s;
    }

    .size-guide-btn:hover {
        color: #000;
    }

    .size-options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
    }

    .size-option {
        padding: 0.75rem;
        border: 1px solid #e5e5e5;
        border-radius: 0.25rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        background: white;
        font-size: 0.875rem;
    }

    .size-option:hover:not(.disabled) {
        border-color: #000;
    }

    .size-option.active {
        border-color: #000;
        background: #000;
        color: white;
    }

    .size-option.disabled {
        color: #ccc;
        text-decoration: line-through;
        cursor: not-allowed;
    }

    /* Buttons */
    .add-to-bag-btn {
        width: 100%;
        padding: 1.25rem;
        background: #000;
        color: white;
        border: none;
        border-radius: 2rem;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
    }

    .add-to-bag-btn:hover:not(:disabled) {
        background: #333;
    }

    .add-to-bag-btn:disabled {
        background: #e5e5e5;
        color: #757575;
        cursor: not-allowed;
    }

    .product-description {
        padding-top: 1.5rem;
        border-top: 1px solid #e5e5e5;
    }

    .product-description h3 {
        font-size: 1.25rem;
        margin: 0 0 1rem 0;
    }

    .product-description p {
        color: #757575;
        line-height: 1.6;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        overflow: auto;
    }

    .modal.active {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background: white;
        border-radius: 0.5rem;
        max-width: 900px;
        width: 90%;
        max-height: 90vh;
        overflow: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e5e5e5;
    }

    .modal-header h2 {
        margin: 0;
        font-size: 1.5rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 2rem;
        cursor: pointer;
        color: #757575;
        padding: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.2s;
    }

    .modal-close:hover {
        background: #f5f5f5;
        color: #000;
    }

    .modal-body {
        padding: 2rem;
    }

    .size-chart-container {
        overflow-x: auto;
    }

    .size-chart-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

    .size-chart-table th {
        text-align: left;
        padding: 0.75rem;
        background: #f5f5f5;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid #e5e5e5;
    }

    .size-chart-table td {
        padding: 0.75rem;
        text-align: center;
        border: 1px solid #e5e5e5;
    }

    .size-chart-table tr:hover {
        background: #fafafa;
    }

    @@media (max-width: 1024px) {
        .product-detail-content {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    @@media (max-width: 640px) {
        .size-options {
            grid-template-columns: repeat(2, 1fr);
        }

        .modal-content {
            width: 95%;
        }

        .modal-header {
            padding: 1rem;
        }

        .modal-body {
            padding: 1rem;
        }
    }
</style>

<script>
    let currentProduct = null;
    let currentImages = [];
    let currentImageIndex = 0;
    let selectedSize = null;
    const slug = '@ViewBag.Slug';
    const styleColor = '@ViewBag.StyleColor';

    document.addEventListener('DOMContentLoaded', function() {
        loadProductDetail();
    });

    async function loadProductDetail() {
        try {
            const response = await fetch(`/api/Products/${slug}/${styleColor}`);
            const result = await response.json();

            if (result.Status && result.Product) {
                currentProduct = result.Product;
                currentImages = result.Product.Images;
                displayProduct(result.Product);
            } else {
                toast.error('Product not found');
                setTimeout(() => {
                    window.location.href = '/Products/Index';
                }, 2000);
            }
        } catch (error) {
            console.error('Error loading product:', error);
            toast.error('Error loading product details');
        }
    }

    function displayProduct(product) {
        // Set product name and category
        document.getElementById('product-name').textContent = product.ProductName;
        document.getElementById('product-category').textContent = product.CategoryName;

        // Set price
        const priceElement = document.getElementById('product-price');
        if (product.PromotionPrice) {
            priceElement.innerHTML = `
                <span style="text-decoration: line-through; color: #757575; font-size: 1.25rem; margin-right: 0.5rem;">${formatPrice(product.Price)}</span>
                <span style="color: #c41e3a;">${formatPrice(product.PromotionPrice)}</span>
            `;
        } else {
            priceElement.textContent = formatPrice(product.Price);
        }

        // Set description
        document.getElementById('product-description-text').textContent = product.Description || 'Không có mô tả.';

        // Display color name
        document.getElementById('selected-color-name').textContent = product.SelectedColorName;

        displayImages(product.Images);

        displayColorOptions(product.AvailableColors);

        displaySizeOptions(product.AvailableSizes);

        document.title = `${product.ProductName} - ${product.SelectedColorName}`;
    }

    function displayImages(images) {
        if (images.length === 0) {
            document.getElementById('main-image').src = '/Content/images/placeholder.png';
            return;
        }

        const sortedImages = images.sort((a, b) => a.DisplayOrder - b.DisplayOrder);

        currentImageIndex = 0;
        currentImages = sortedImages;
        document.getElementById('main-image').src = sortedImages[0].ImageURL;

        const thumbnailContainer = document.getElementById('thumbnail-container');
        thumbnailContainer.innerHTML = sortedImages.map((img, index) => `
            <div class="thumbnail-item ${index === 0 ? 'active' : ''}" onclick="selectImage(${index})">
                <img src="${img.ImageURL}" alt="Product thumbnail" />
            </div>
        `).join('');
    }

    function selectImage(index) {
        currentImageIndex = index;
        document.getElementById('main-image').src = currentImages[index].ImageURL;

        // Update active thumbnail
        document.querySelectorAll('.thumbnail-item').forEach((thumb, i) => {
            thumb.classList.toggle('active', i === index);
        });
    }

    function previousImage() {
        currentImageIndex = (currentImageIndex - 1 + currentImages.length) % currentImages.length;
        selectImage(currentImageIndex);
    }

    function nextImage() {
        currentImageIndex = (currentImageIndex + 1) % currentImages.length;
        selectImage(currentImageIndex);
    }

    function displayColorOptions(colors) {
        const colorContainer = document.getElementById('color-options');
        colorContainer.innerHTML = colors.map(color => `
            <div class="color-option ${color.StyleColor === currentProduct.SelectedStyleColor ? 'active' : ''} ${!color.IsAvailable ? 'disabled' : ''}"
                 onclick="${color.IsAvailable ? `changeColor('${color.StyleColor}')` : ''}"
                 title="${color.ColorName}">
                <img src="${color.ThumbnailImage}" alt="${color.ColorName}" />
            </div>
        `).join('');
    }

    async function changeColor(newStyleColor) {
        if (newStyleColor === currentProduct.SelectedStyleColor) return;

        try {
            const response = await fetch(`/api/Products/${slug}/${newStyleColor}`);
            const result = await response.json();

            if (result.Status && result.Product) {
                currentProduct = result.Product;
                currentImages = result.Product.Images;

                document.getElementById('selected-color-name').textContent = result.Product.SelectedColorName;

                displayImages(result.Product.Images);
                displayColorOptions(result.Product.AvailableColors);
                displaySizeOptions(result.Product.AvailableSizes);

                selectedSize = null;
                document.getElementById('add-to-bag-btn').disabled = true;

                window.history.pushState({}, '', `/products/${slug}/${newStyleColor}`);

                document.title = `${result.Product.ProductName} - ${result.Product.SelectedColorName}`;
            }
        } catch (error) {
            console.error('Error changing color:', error);
        }
    }

    function displaySizeOptions(sizes) {
        const sizeContainer = document.getElementById('size-options');
        sizeContainer.innerHTML = sizes.map(size => `
            <button class="size-option ${!size.IsAvailable ? 'disabled' : ''}"
                    onclick="${size.IsAvailable ? `selectSize(${size.VariantID}, '${size.SizeValue}')` : ''}"
                    ${!size.IsAvailable ? 'disabled' : ''}>
                EU ${size.SizeValue}
            </button>
        `).join('');
    }

    function selectSize(variantId, sizeValue) {
        selectedSize = variantId;

        // Update active state
        document.querySelectorAll('.size-option').forEach(btn => {
            btn.classList.remove('active');
        });
        event.target.classList.add('active');

        // Enable add to bag button
        document.getElementById('add-to-bag-btn').disabled = false;
    }

    function addToBag() {
        if (!selectedSize) {
            toast.warning('Vui lòng chọn Size');
            return;
        }

        const selectedVariant = currentProduct.AvailableSizes.find(s => s.VariantID === selectedSize);
        if (!selectedVariant) {
            toast.error('Không có size đã chọn');
            return;
        }

        const cartItem = {
            id: currentProduct.ProductID,
            variantId: selectedSize,
            name: currentProduct.ProductName,
            slug: currentProduct.Slug,
            styleColor: currentProduct.SelectedStyleColor,
            colorName: currentProduct.SelectedColorName,
            size: selectedVariant.SizeValue,
            price: currentProduct.Price,
            promotionPrice: currentProduct.PromotionPrice,
            quantity: 1,
            stockQty: selectedVariant.StockQty,
            images: [currentProduct.Images[0].ImageURL]
        };

        cart.addItem(cartItem, selectedVariant.SizeValue);
    }

    function openSizeGuide() {
        document.getElementById('size-guide-modal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeSizeGuide() {
        document.getElementById('size-guide-modal').classList.remove('active');
        document.body.style.overflow = '';
    }

    window.onclick = function(event) {
        const modal = document.getElementById('size-guide-modal');
        if (event.target === modal) {
            closeSizeGuide();
        }
    }

    function formatPrice(price) {
        return new Intl.NumberFormat('vi-VN', {
            style: 'currency',
            currency: 'VND'
        }).format(price);
    }
</script>
