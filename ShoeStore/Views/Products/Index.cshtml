@{
    ViewBag.Title = "Products";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<div class="px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-[1920px]">
        <div class="mb-6">
            <h1 class="text-3xl font-bold mb-2" id="page-title">All Shoes</h1>
            <div id="product-count" style="font-size: 0.875rem; color: #6b7280;"></div>
        </div>

        <div class="flex gap-8">
            <aside class="filter-sidebar" style="min-width: 260px; width: 260px;">
                <div class="filter-group">
                    <button class="filter-group-header" onclick="toggleFilterGroup('gender-filter')">
                        <div>
                            <span>Giới tính</span>
                            <span id="gender-count" class="filter-count"></span>
                        </div>
                        <svg class="chevron" width="14" height="14" viewBox="0 0 14 14">
                            <path d="M1 4l6 6 6-6" stroke="currentColor" fill="none" stroke-width="1.5"></path>
                        </svg>
                    </button>
                    <div class="filter-group-content" id="gender-filter">
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="Men" data-group="gender" />
                            <span class="checkmark"></span>
                            <span>Men</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="Women" data-group="gender" />
                            <span class="checkmark"></span>
                            <span>Women</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="Kid" data-group="gender" />
                            <span class="checkmark"></span>
                            <span>Kids</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="Unisex" data-group="gender" />
                            <span class="checkmark"></span>
                            <span>Unisex</span>
                        </label>
                    </div>
                </div>

                <div class="filter-group">
                    <button class="filter-group-header" onclick="toggleFilterGroup('price-filter')">
                        <div>
                            <span>Giá tiền</span>
                            <span id="price-count" class="filter-count"></span>
                        </div>
                        <svg class="chevron" width="14" height="14" viewBox="0 0 14 14">
                            <path d="M1 4l6 6 6-6" stroke="currentColor" fill="none" stroke-width="1.5"></path>
                        </svg>
                    </button>
                    <div class="filter-group-content" id="price-filter">
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="0-1000000" data-group="price" />
                            <span class="checkmark"></span>
                            <span>Dưới 1,000,000₫</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="1000000-2000000" data-group="price" />
                            <span class="checkmark"></span>
                            <span>1,000,000₫ - 2,000,000₫</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="2000000-5000000" data-group="price" />
                            <span class="checkmark"></span>
                            <span>2,000,000₫ - 5,000,000₫</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="5000000-999999999" data-group="price" />
                            <span class="checkmark"></span>
                            <span>Trên 5,000,000₫</span>
                        </label>
                    </div>
                </div>

                <div class="filter-group">
                    <button class="filter-group-header" onclick="toggleFilterGroup('size-filter')">
                        <div>
                            <span>Size</span>
                            <span id="size-count" class="filter-count"></span>
                        </div>
                        <svg class="chevron" width="14" height="14" viewBox="0 0 14 14">
                            <path d="M1 4l6 6 6-6" stroke="currentColor" fill="none" stroke-width="1.5"></path>
                        </svg>
                    </button>
                    <div class="filter-group-content" id="size-filter">
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="38.5" data-group="size" />
                            <span class="checkmark"></span>
                            <span>38.5</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="39" data-group="size" />
                            <span class="checkmark"></span>
                            <span>39</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="40" data-group="size" />
                            <span class="checkmark"></span>
                            <span>40</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="40.5" data-group="size" />
                            <span class="checkmark"></span>
                            <span>40.5</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="41" data-group="size" />
                            <span class="checkmark"></span>
                            <span>41</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="42" data-group="size" />
                            <span class="checkmark"></span>
                            <span>42</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="42.5" data-group="size" />
                            <span class="checkmark"></span>
                            <span>42.5</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="43" data-group="size" />
                            <span class="checkmark"></span>
                            <span>43</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="44" data-group="size" />
                            <span class="checkmark"></span>
                            <span>44</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="44.5" data-group="size" />
                            <span class="checkmark"></span>
                            <span>44.5</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="45" data-group="size" />
                            <span class="checkmark"></span>
                            <span>45</span>
                        </label>
                        <label class="filter-item">
                            <input type="checkbox" class="filter-checkbox" value="45.5" data-group="size" />
                            <span class="checkmark"></span>
                            <span>45.5</span>
                        </label>
                    </div>
                </div>
            </aside>

            <div style="flex: 1;">
                <div class="mb-4 flex justify-between items-center">
                    <div style="font-size: 0.875rem;">
                        <label for="sort-select" style="margin-right: 0.5rem;">Sort By:</label>
                        <select id="sort-select" class="input" style="display: inline-block; width: auto; padding: 0.5rem;" onchange="applyFilters()">
                            <option value="newest">Newest</option>
                            <option value="price-low">Giá: Thấp đến cao</option>
                            <option value="price-high">Giá: Cao đến thấp</option>
                        </select>
                    </div>
                    <div class="search-input-wrapper">
                        <button class="search-icon-btn" type="button" aria-label="Search">
                            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" role="img" width="24px" height="24px" fill="none">
                                <path stroke="currentColor" stroke-width="1.5" d="M13.962 16.296a6.716 6.716 0 01-3.462.954 6.728 6.728 0 01-4.773-1.977A6.728 6.728 0 013.75 10.5c0-1.864.755-3.551 1.977-4.773A6.728 6.728 0 0110.5 3.75c1.864 0 3.551.755 4.773 1.977A6.728 6.728 0 0117.25 10.5a6.726 6.726 0 01-.921 3.407c-.517.882-.434 1.988.289 2.711l3.853 3.853"></path>
                            </svg>
                        </button>
                        <input type="search" id="search-input" class="search-input" placeholder="Tìm kiếm" autocomplete="off" aria-label="Tìm kiếm sản phẩm" />
                        <button class="search-clear-btn" id="search-clear-btn" type="button" aria-label="Xóa tìm kiếm" style="display: none;">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div id="product-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 2rem; max-width: 1400px;">
                </div>

                <div id="pagination" style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 2rem;">
                </div>

                <div id="loading" style="display: none; text-align: center; padding: 2rem;">
                    <p style="color: #6b7280;">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .search-input-wrapper {
            position: relative;
            width: 300px;
            display: flex;
            align-items: center;
            background: #f5f5f5;
            border-radius: 100px;
            padding: 6px 12px;
            transition: background 0.2s;
        }

        .search-input-wrapper:focus-within {
            background: #e5e5e5;
        }

        .search-icon-btn {
            background: none;
            border: none;
            padding: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #757575;
            flex-shrink: 0;
        }

        .search-icon-btn svg {
            width: 20px;
            height: 20px;
        }

        .search-input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 6px 10px;
            font-size: 14px;
            outline: none;
            color: #111;
        }

        .search-input::placeholder {
            color: #8d8d8d;
        }

        .search-clear-btn {
            background: none;
            border: none;
            padding: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #757575;
            flex-shrink: 0;
            transition: color 0.2s;
        }

        .search-clear-btn svg {
            width: 16px;
            height: 16px;
        }

        .search-clear-btn:hover {
            color: #111;
        }

        .filter-sidebar {
            border-right: 1px solid #e5e5e5;
            padding-right: 1.5rem;
        }

        .filter-group {
            border-bottom: 1px solid #e5e5e5;
            padding: 1.5rem 0;
        }

        .filter-group-header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            padding: 0;
            text-align: left;
        }

        .filter-group-header div {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .filter-count {
            font-size: 0.875rem;
            color: #6b7280;
        }

        .chevron {
            transition: transform 0.2s;
        }

        .filter-group-header.open .chevron {
            transform: rotate(180deg);
        }

        .filter-group-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }

        .filter-group-content.open {
            max-height: 500px;
            padding-top: 1rem;
        }

        .filter-item {
            display: flex;
            align-items: center;
            padding: 0.5rem 0;
            cursor: pointer;
            font-size: 0.875rem;
            position: relative;
        }

        .filter-item input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

        .filter-item .checkmark {
            position: relative;
            display: inline-block;
            width: 1.25rem;
            height: 1.25rem;
            margin-right: 0.75rem;
            border: 2px solid #d1d5db;
            border-radius: 0.25rem;
            background: white;
            flex-shrink: 0;
        }

        .filter-item input[type="checkbox"]:checked ~ .checkmark {
            background: black;
            border-color: black;
        }

        .filter-item .checkmark:after {
            content: "";
            position: absolute;
            display: none;
            left: 5px;
            top: 2px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .filter-item input[type="checkbox"]:checked ~ .checkmark:after {
            display: block;
        }

        .filter-checkbox {
            position: static;
            width: 1.25rem;
            height: 1.25rem;
            margin-right: 0.75rem;
            cursor: pointer;
            clip: auto;
            clip-path: none;
            overflow: visible;
        }

        .product-card {
            display: block;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            transition: transform 0.2s;
            max-width: 400px;
            margin: 0 auto;
        }

        .product-card:hover {
            transform: translateY(-4px);
        }

        .product-image-container {
            position: relative;
            width: 100%;
            max-width: 400px;
            aspect-ratio: 1 / 1;
            background: #f5f5f5;
            border-radius: 0.5rem;
            overflow: hidden;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .color-variants {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .color-variant-thumbnail {
            width: 2rem;
            height: 2rem;
            border-radius: 0.25rem;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
        }

        .color-variant-thumbnail:hover {
            border-color: #000;
        }

        .color-variant-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-info {
            display: flex;
            flex-direction: column;
        }

        .product-info h4 {
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 1rem;
        }

        .product-info h5 {
            color: #6b7280;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }

        .product-price {
            font-weight: 600;
            font-size: 1rem;
        }

        .product-price-original {
            color: #6b7280;
            text-decoration: line-through;
            margin-left: 0.5rem;
            font-size: 0.875rem;
        }

        .pagination-btn {
            padding: 0.5rem 1rem;
            border: 1px solid #ccc;
            background: white;
            cursor: pointer;
            border-radius: 0.25rem;
        }

        .pagination-btn:hover:not(:disabled) {
            background: #f5f5f5;
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .pagination-btn.active {
            background: black;
            color: white;
            border-color: black;
        }

        @@media (max-width: 1024px) {
            #product-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }

            .filter-sidebar {
                min-width: 200px !important;
                width: 200px !important;
            }

            .search-input-wrapper {
                width: 250px;
            }
        }

        @@media (max-width: 768px) {
            .filter-sidebar {
                display: none;
            }

            #product-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }

            .mb-4.flex {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 1rem;
            }

            .search-input-wrapper {
                width: 100%;
                max-width: 100%;
            }
        }

        @@media (max-width: 640px) {
            #product-grid {
                grid-template-columns: 1fr !important;
                gap: 1.5rem !important;
            }

            .search-input-wrapper {
                width: 100%;
            }

            .px-4 {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }

            .py-8 {
                padding-top: 2rem !important;
                padding-bottom: 2rem !important;
            }
        }
    </style>
}

@section Scripts {
    <script>
    let currentPage = 1;
    let searchQuery = '';
    let currentFilters = {
        gender: [],
        price: [],
        size: [],
        sortBy: 'newest'
    };

    function toggleFilterGroup(id) {
        const content = document.getElementById(id);
        const header = content.previousElementSibling;

        if (content.classList.contains('open')) {
            content.classList.remove('open');
            header.classList.remove('open');
        } else {
            content.classList.add('open');
            header.classList.add('open');
        }
    }

    function getUrlParameter(name) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(name);
    }

    function initializeFilters() {
        const genderParam = getUrlParameter('gender');
        if (genderParam) {
            const checkboxes = document.querySelectorAll('input[data-group="gender"]');
            checkboxes.forEach(cb => {
                if (cb.value === genderParam) {
                    cb.checked = true;
                    currentFilters.gender.push(cb.value);
                }
            });

            document.getElementById('gender-filter').classList.add('open');
            document.querySelector('#gender-filter').previousElementSibling.classList.add('open');

            const titles = {
                'Men': "Men's Shoes",
                'Women': "Women's Shoes",
                'Kid': "Kids' Shoes",
                'Unisex': "Unisex Shoes"
            };
            document.getElementById('page-title').textContent = titles[genderParam] || 'All Shoes';
        } else {
            document.getElementById('gender-filter').classList.add('open');
            document.querySelector('#gender-filter').previousElementSibling.classList.add('open');
        }

        document.getElementById('price-filter').classList.add('open');
        document.querySelector('#price-filter').previousElementSibling.classList.add('open');
        document.getElementById('size-filter').classList.add('open');
        document.querySelector('#size-filter').previousElementSibling.classList.add('open');
    }

    async function loadProducts() {
        const productGrid = document.getElementById('product-grid');

        try {
            const params = new URLSearchParams({
                page: currentPage,
                pageSize: 15,
                sortBy: currentFilters.sortBy
            });

            if (searchQuery) params.append('search', searchQuery);
            if (currentFilters.gender.length > 0) params.append('gender', currentFilters.gender.join(','));
            if (currentFilters.size.length > 0) params.append('sizes', currentFilters.size.join(','));

            if (currentFilters.price.length > 0) {
                const priceRanges = currentFilters.price.map(p => p.split('-').map(Number));
                const minPrice = Math.min(...priceRanges.map(r => r[0]));
                const maxPrice = Math.max(...priceRanges.map(r => r[1]));
                params.append('minPrice', minPrice);
                if (maxPrice < 999999999) params.append('maxPrice', maxPrice);
            }

            const response = await fetch(`/api/Products?${params.toString()}`);
            const result = await response.json();

            if (result.Status) {
                displayProducts(result.Products);
                displayPagination(result.CurrentPage, result.TotalPages, result.TotalProducts);
                updateFilterCounts();
            } else {
                productGrid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; padding: 2rem; color: #6b7280;">Không tìm thấy sản phẩm nào.</p>';
            }
        } catch (error) {
            console.error('Error loading products:', error);
            productGrid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; padding: 2rem; color: #ef4444;">Lỗi khi tải danh sách sản phẩm.</p>';
        }
    }

    function updateFilterCounts() {
        const genderCount = currentFilters.gender.length;
        const priceCount = currentFilters.price.length;
        const sizeCount = currentFilters.size.length;

        document.getElementById('gender-count').textContent = genderCount > 0 ? `(${genderCount})` : '';
        document.getElementById('price-count').textContent = priceCount > 0 ? `(${priceCount})` : '';
        document.getElementById('size-count').textContent = sizeCount > 0 ? `(${sizeCount})` : '';
    }

    function displayProducts(products) {
        const container = document.getElementById('product-grid');

        if (products.length === 0) {
            container.innerHTML = '<p style="grid-column: 1/-1; text-align: center; padding: 2rem; color: #6b7280;">Không tìm thấy sản phẩm nào.</p>';
            return;
        }

        container.innerHTML = products.map(product => {
            const mainVariant = product.ColorVariants[0];
            const price = product.PromotionPrice || product.Price;
            const hasPromotion = product.PromotionPrice !== null && product.PromotionPrice < product.Price;

            return `
                <div class="product-card" onclick="navigateToProduct('${product.Slug}', '${mainVariant.StyleColor}')">
                    <div class="product-image-container">
                        <img src="${mainVariant.MainImageURL}" alt="${product.ProductName}" class="product-image" id="main-img-${product.ProductID}" />
                    </div>
                    ${product.ColorVariants.length > 1 ? `
                        <div class="color-variants">
                            ${product.ColorVariants.map((variant, idx) => `
                                <div class="color-variant-thumbnail"
                                     onmouseover="changeMainImage(${product.ProductID}, '${variant.MainImageURL}')"
                                     onmouseout="resetMainImage(${product.ProductID}, '${mainVariant.MainImageURL}')"
                                     onclick="event.stopPropagation(); navigateToProduct('${product.Slug}', '${variant.StyleColor}')">
                                    <img src="${variant.MainImageURL}" alt="${variant.ColorName}" />
                                </div>
                            `).join('')}
                        </div>
                    ` : ''}
                    <div class="product-info">
                        <h4>${product.ProductName}</h4>
                        <h5>${product.CategoryName}</h5>
                        <div class="product-price">
                            ${price.toLocaleString()}₫
                            ${hasPromotion ? `<span class="product-price-original">${product.Price.toLocaleString()}₫</span>` : ''}
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    function changeMainImage(productId, imageUrl) {
        const img = document.getElementById(`main-img-${productId}`);
        if (img) img.src = imageUrl;
    }

    function resetMainImage(productId, originalUrl) {
        const img = document.getElementById(`main-img-${productId}`);
        if (img) img.src = originalUrl;
    }

    function navigateToProduct(slug, styleColor) {
        window.location.href = `/products/${slug}/${styleColor}`;
    }

    function displayPagination(currentPageNum, totalPages, totalProducts) {
        const paginationContainer = document.getElementById('pagination');
        const countContainer = document.getElementById('product-count');

        countContainer.textContent = `${totalProducts} Kết quả`;

        if (totalPages <= 1) {
            paginationContainer.innerHTML = '';
            return;
        }

        let paginationHTML = `
            <button class="pagination-btn" onclick="changePage(${currentPageNum - 1})" ${currentPageNum === 1 ? 'disabled' : ''}>
                Trước
            </button>
        `;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPageNum - 2 && i <= currentPageNum + 2)) {
                paginationHTML += `
                    <button class="pagination-btn ${i === currentPageNum ? 'active' : ''}" onclick="changePage(${i})">
                        ${i}
                    </button>
                `;
            } else if (i === currentPageNum - 3 || i === currentPageNum + 3) {
                paginationHTML += `<span style="padding: 0.5rem;">...</span>`;
            }
        }

        paginationHTML += `
            <button class="pagination-btn" onclick="changePage(${currentPageNum + 1})" ${currentPageNum === totalPages ? 'disabled' : ''}>
                Kế tiếp
            </button>
        `;

        paginationContainer.innerHTML = paginationHTML;
    }

    function changePage(page) {
        currentPage = page;
        loadProducts();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function applyFilters(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        currentFilters.gender = [];
        currentFilters.price = [];
        currentFilters.size = [];

        document.querySelectorAll('input[data-group="gender"]:checked').forEach(cb => {
            currentFilters.gender.push(cb.value);
        });

        document.querySelectorAll('input[data-group="price"]:checked').forEach(cb => {
            currentFilters.price.push(cb.value);
        });

        document.querySelectorAll('input[data-group="size"]:checked').forEach(cb => {
            currentFilters.size.push(cb.value);
        });

        currentFilters.sortBy = document.getElementById('sort-select').value;

        currentPage = 1;
        loadProducts();
    }

    document.querySelectorAll('.filter-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', function(e) {
            e.preventDefault();
            e.stopPropagation();
            applyFilters();
        });
    });

    // Also prevent label clicks from propagating
    document.querySelectorAll('.filter-item').forEach(label => {
        label.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });

    const searchInput = document.getElementById('search-input');
    const searchClearBtn = document.getElementById('search-clear-btn');

    searchInput.addEventListener('input', function() {
        searchQuery = this.value;

        if (searchQuery) {
            searchClearBtn.style.display = 'flex';
        } else {
            searchClearBtn.style.display = 'none';
        }

        currentPage = 1;
        loadProducts();
    });

    searchClearBtn.addEventListener('click', function() {
        searchInput.value = '';
        searchQuery = '';
        searchClearBtn.style.display = 'none';
        currentPage = 1;
        loadProducts();
    });

    document.addEventListener('DOMContentLoaded', function() {
        initializeFilters();
        loadProducts();
    });
    </script>
}
